  <owl:Class rdf:about="https://w3id.org/damlevels/ontology/DayInterval">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
    <rdfs:label xml:lang="en">interval of whole reporting days</rdfs:label>
    <skos:definition xml:lang="en">An interval of one or more whole reporting days (local calendar, Africa/Tunis). It begins at the day-granular instant of its first day and ends at the day-granular instant of the day after its last day, so that consecutive intervals meet and the daily amount printed on the bulletin of D ends at the state instant of D. time:hasXSDDuration gives the number of days. No clock time is asserted, because the bulletins print none.</skos:definition>
    <skos:scopeNote xml:lang="en">Whether a reporting day runs from reading to reading (hydrological day) or from midnight to midnight is not printed; both readings give the same triples.</skos:scopeNote>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/"/>
  </owl:Class>
  <dlo:Catchment rdf:about="https://w3id.org/damlevels/id/catchment/nebhana">
