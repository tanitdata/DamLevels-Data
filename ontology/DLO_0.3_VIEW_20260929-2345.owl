    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H03">
        <dcterms:description xml:lang="en">p1_release_today(D) equals p1_release_yesterday on the bulletin of the same calendar date one year earlier — previous-year interval release</dcterms:description>
        <dcterms:identifier>H03</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">exact at printed precision; alternatives -365d: 86.2%, -366d: 72.4%, -364d: 59.3%, +1d: 63.1%, -1d: 63.9%</rdfs:comment>
        <skos:note xml:lang="en">Same calendar date is the best single offset, but mismatches cluster in dated periods (see H02c).</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">91.098</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">114415</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">104230</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H03c">
        <dcterms:description xml:lang="en">p1_release_today(D) equals p1_release_yesterday on the bulletin of the per-bulletin reference date (calendar fitted on storage)</dcterms:description>
        <dcterms:identifier>H03c</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">out-of-sample check of the storage-fitted calendar; 710 of 3675 bulletins use a shifted reference; periods of 5+ bulletins: 2016-02-29..2016-03-05: +1 d; 2016-03-08..2016-06-16: +1 d; 2016-06-18..2016-07-13: +1 d; 2016-07-15..2016-09-02: +1 d; 2017-03-01..2017-07-23: -1 d; 2017-07-28..2017-09-04: -1 d; 2020-02-29..2020-06-01: +1 d; 2024-02-29..2024-03-20: +1 d; 2025-03-01..2025-10-10: -1 d</rdfs:comment>
        <skos:note xml:lang="en">The reference date is the same calendar date one year earlier, except in dated periods around leap years where the publisher used the same day of the year (+-1 day). The converter reads the per-bulletin reference date from PREVIOUS_YEAR_REFERENCE_CALENDAR.csv.</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">98.504</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">114777</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">113060</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H13">
        <dcterms:description xml:lang="en">p1_release_today equals Page 2 outflow_reporting_interval_p2_mm3 (NEGATIVE CONTROL: previous-year release)</dcterms:description>
        <dcterms:identifier>H13</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">exact at printed precision</rdfs:comment>
        <skos:note xml:lang="en">Rejected pairing confirms p1_release_today is not the current release.</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">14.281</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">82002</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">11711</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H23b">
        <dcterms:description xml:lang="en">NEGATIVE CONTROL: same balance with p1_release_today closes within 0.01 Mm3</dcterms:description>
        <dcterms:identifier>H23b</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">should be clearly worse than H23</rdfs:comment>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">42.872</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">127192</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">54530</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29a"/>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29b"/>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29c"/>
    <dlo:temporalSupport>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/PreviousYearSameDay">
        <skos:closeMatch rdf:resource="http://vocabulary.odm2.org/aggregationstatistic/incremental/"/>
        <skos:closeMatch rdf:resource="http://www.opengis.net/def/waterml/2.0/interpolationType/TotalPrec"/>
        <skos:definition xml:lang="en">The same daily amount for the day before R(D), i.e. the daily amount printed on the reference bulletin one year earlier.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/TemporalSupportScheme"/>
        <skos:notation>PREVIOUS_YEAR_SAME_DAY</skos:notation>
