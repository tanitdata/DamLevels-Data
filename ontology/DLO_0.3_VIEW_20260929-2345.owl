      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H05">
        <dcterms:description xml:lang="en">p1_release_cumul_last_year(D) equals p1_release_cumul_year on the bulletin of the same calendar date one year earlier — previous-year season-to-date release</dcterms:description>
        <dcterms:identifier>H05</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">exact at printed precision; alternatives -365d: 68.6%, -366d: 54.6%, -364d: 38.0%, +1d: 40.9%, -1d: 43.7%</rdfs:comment>
        <skos:note xml:lang="en">Same calendar date is the best single offset, but mismatches cluster in dated periods (see H02c).</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">77.170</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">112737</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">86999</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H05c">
        <dcterms:description xml:lang="en">p1_release_cumul_last_year(D) equals p1_release_cumul_year on the bulletin of the per-bulletin reference date (calendar fitted on storage)</dcterms:description>
        <dcterms:identifier>H05c</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">out-of-sample check of the storage-fitted calendar; 710 of 3675 bulletins use a shifted reference; periods of 5+ bulletins: 2016-02-29..2016-03-05: +1 d; 2016-03-08..2016-06-16: +1 d; 2016-06-18..2016-07-13: +1 d; 2016-07-15..2016-09-02: +1 d; 2017-03-01..2017-07-23: -1 d; 2017-07-28..2017-09-04: -1 d; 2020-02-29..2020-06-01: +1 d; 2024-02-29..2024-03-20: +1 d; 2025-03-01..2025-10-10: -1 d</rdfs:comment>
        <skos:note xml:lang="en">The reference date is the same calendar date one year earlier, except in dated periods around leap years where the publisher used the same day of the year (+-1 day). The converter reads the per-bulletin reference date from PREVIOUS_YEAR_REFERENCE_CALENDAR.csv.</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">84.169</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">113091</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">95187</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
