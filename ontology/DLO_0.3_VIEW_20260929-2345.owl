  <owl:ObjectProperty rdf:about="https://w3id.org/damlevels/ontology/reportedOperation">
    <rdfs:label xml:lang="en">reported operation</rdfs:label>
    <skos:definition xml:lang="en">An operation code printed beside the release (scheme dlc:OperationCodeScheme, provisional meanings).</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/damlevels/ontology/BulletinObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="https://w3id.org/damlevels/ontology/">
        <owl:versionIRI rdf:resource="https://w3id.org/damlevels/ontology/0.3.0/"/>
        <owl:versionInfo>0.3.0 — research build of 2026-09-29, pending owner review</owl:versionInfo>
        <owl:priorVersion rdf:resource="https://w3id.org/damlevels/ontology/0.2.0/"/>
        <dcterms:title xml:lang="en">DamLevels Ontology (DLO)</dcterms:title>
        <dcterms:title xml:lang="fr">Ontologie DamLevels</dcterms:title>
        <dcterms:description xml:lang="en">Ontology for the daily reservoir bulletins of the Tunisian Direction Générale des Barrages et des Grands Travaux Hydrauliques (DGBGTH). It represents each printed quantity as a W3C SOSA observation whose observed property is an RDA I-ADOPT variable, whose phenomenon time is an OWL-Time entity fixed by an empirically tested temporal support rule, and whose result is a QUDT quantity value. Dams, impounded water bodies, managed reservoirs and catchments align with OGC HY_Features and OBO ENVO. Lineage uses W3C PROV-O.</dcterms:description>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-29</dcterms:created>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-29</dcterms:modified>
        <dcterms:source rdf:resource="https://w3id.org/damlevels/ontology/docs/research-design"/>
        <vann:preferredNamespacePrefix>dlo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/damlevels/ontology/</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Namespace https://w3id.org/damlevels/ is a placeholder until registered with w3id.org. Licence and creators are deliberately not asserted until the project owner approves them (see docs/PUBLICATION_CHECKLIST.md). sosa:ObservationCollection, sosa:hasMember and sosa:Property come from the SOSA/SSN revision (W3C draft); variables are also typed with the 2017 sosa:ObservableProperty.</rdfs:comment>
        <rdfs:comment xml:lang="en">PROTÉGÉ VIEW FILE (20260929-2345) — merged schema modules + features + 200 sample observations, no owl:imports. For looking only: the source modules are the dlo-*.ttl files.</rdfs:comment>
        <dcterms:references rdf:resource="http://www.w3.org/ns/sosa/"/>
        <dcterms:references rdf:resource="https://w3id.org/iadopt/ont/"/>
        <dcterms:references rdf:resource="http://www.w3.org/2006/time#"/>
        <dcterms:references rdf:resource="http://qudt.org/schema/qudt/"/>
        <dcterms:references rdf:resource="https://www.opengis.net/def/schema/hy_features/hyf/"/>
        <dcterms:references rdf:resource="http://www.w3.org/ns/prov#"/>
        <dcterms:references rdf:resource="http://www.w3.org/ns/dqv#"/>
        <dcterms:references rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
      </owl:Ontology>
    </rdfs:isDefinedBy>
  </owl:ObjectProperty>
  <dlo:ColumnMapping rdf:about="https://w3id.org/damlevels/id/mapping/P2_observations/p2_erosion_mm_an">
    <rdfs:label>p2_erosion_mm_an (P2_observations)</rdfs:label>
    <dlo:emissionMode>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/EmitRunLength">
        <skos:definition xml:lang="en">One observation for each run of consecutive bulletins that print the identical value (and status) for the same reservoir. The first and last bulletin and the run length are recorded, so no printed information is lost.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/EmissionModeScheme"/>
        <skos:notation>RUN_LENGTH</skos:notation>
        <skos:prefLabel xml:lang="en">one per run of identical values</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/EmissionModeScheme"/>
      </skos:Concept>
    </dlo:emissionMode>
    <dlo:evidenceNote>PATCH_01</dlo:evidenceNote>
    <dlo:expectedUnit rdf:resource="http://qudt.org/vocab/unit/MilliM-PER-YR"/>
    <dlo:featureRole>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/RoleCatchment">
        <rdfs:seeAlso rdf:resource="https://w3id.org/damlevels/ontology/Catchment"/>
        <skos:definition xml:lang="en">Values are about a feature of class dlo:Catchment.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/FeatureRoleScheme"/>
        <skos:notation>CATCHMENT</skos:notation>
        <skos:prefLabel xml:lang="en">catchment</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/FeatureRoleScheme"/>
      </skos:Concept>
    </dlo:featureRole>
    <dlo:inRegime>
      <dlo:SchemaRegime rdf:about="https://w3id.org/damlevels/id/regime/P2_observations/2014-07-02_2025-10-10">
        <rdfs:label xml:lang="en">P2_observations layout 2014-07-02 to 2025-10-10</rdfs:label>
        <dlo:regimeValidFrom rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-07-02</dlo:regimeValidFrom>
        <dlo:regimeValidTo rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-10</dlo:regimeValidTo>
      </dlo:SchemaRegime>
    </dlo:inRegime>
    <dlo:mappingConfidence rdf:resource="https://w3id.org/damlevels/code/ConfidenceMedium"/>
    <dlo:mapsToVariable>
      <sosa:ObservableProperty rdf:about="https://w3id.org/damlevels/variable/CatchmentErosionRate">
        <rdf:type rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
        <rdfs:label xml:lang="en">equivalent catchment erosion</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
        <skos:altLabel xml:lang="fr">Erosion (mm/an)</skos:altLabel>
        <skos:definition xml:lang="en">Sediment yield expressed as equivalent soil depth per year.</skos:definition>
        <skos:prefLabel xml:lang="en">equivalent catchment erosion</skos:prefLabel>
        <dlo:canonicalUnit rdf:resource="http://qudt.org/vocab/unit/MilliM-PER-YR"/>
        <iop:hasContextObject rdf:resource="https://w3id.org/damlevels/variable/Catchment"/>
        <iop:hasObjectOfInterest rdf:resource="https://w3id.org/damlevels/variable/Soil"/>
        <iop:hasProperty rdf:resource="https://w3id.org/damlevels/variable/DepthRate"/>
        <iop:hasStatisticalModifier rdf:resource="https://w3id.org/damlevels/variable/LongTermMean"/>
      </sosa:ObservableProperty>
    </dlo:mapsToVariable>
    <dlo:semanticLayer>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/LayerRegimeParameter">
        <skos:definition xml:lang="en">Values whose mathematical behaviour is 'as_of'.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/SemanticLayerScheme"/>
        <skos:notation>regime_parameter</skos:notation>
        <skos:prefLabel xml:lang="en">regime parameter</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/SemanticLayerScheme"/>
        <dlo:safeCrossReservoirAggregation xml:lang="en">aggregate only with a defined physical formula</dlo:safeCrossReservoirAggregation>
        <dlo:safeTemporalAggregation xml:lang="en">date-effective as-of join; preserve regime boundaries</dlo:safeTemporalAggregation>
      </skos:Concept>
    </dlo:semanticLayer>
    <dlo:sourceColumn>p2_erosion_mm_an</dlo:sourceColumn>
    <dlo:sourceTable>
      <dlo:SourceTable rdf:about="https://w3id.org/damlevels/id/source-table/P2_observations">
