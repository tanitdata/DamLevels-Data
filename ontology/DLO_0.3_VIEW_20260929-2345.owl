    <rdfs:label xml:lang="en">elevation</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
    <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
    <skos:definition xml:lang="en">Height above the national vertical datum.</skos:definition>
  </iop:Property>
  <iop:Constraint rdf:about="https://w3id.org/damlevels/variable/SpillwayDesign">
    <rdfs:label xml:lang="en">spillway design</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
    <skos:definition xml:lang="en">At the design capacity of the spillway.</skos:definition>
    <iop:constrains>
      <iop:Entity rdf:about="https://w3id.org/damlevels/variable/Water">
        <rdfs:label xml:lang="en">water</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
        <skos:definition xml:lang="en">Liquid water moving into, out of, or between reservoirs.</skos:definition>
