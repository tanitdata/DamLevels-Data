    <dlo:mapsToVariable>
      <sosa:ObservableProperty rdf:about="https://w3id.org/damlevels/variable/StorageFillRatio">
        <rdf:type rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdf:type rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
        <rdfs:label xml:lang="en">storage fill percentage</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
        <skos:altLabel xml:lang="ar">نسبة الامتلاء</skos:altLabel>
        <skos:altLabel xml:lang="fr">Taux de remplissage</skos:altLabel>
        <skos:definition xml:lang="en">Stored volume divided by the useful capacity in force, in percent, as printed.</skos:definition>
        <skos:prefLabel xml:lang="en">storage fill percentage</skos:prefLabel>
        <dlo:canonicalUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <iop:hasObjectOfInterest rdf:resource="https://w3id.org/damlevels/variable/ImpoundedWaterOverUsefulStorageSpace"/>
        <iop:hasProperty rdf:resource="https://w3id.org/damlevels/variable/Ratio"/>
      </sosa:ObservableProperty>
    </dlo:mapsToVariable>
    <dlo:semanticLayer>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/LayerState">
        <skos:definition xml:lang="en">Values whose mathematical behaviour is 'as_of_or_endpoint'.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/SemanticLayerScheme"/>
        <skos:notation>state</skos:notation>
        <skos:prefLabel xml:lang="en">state</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/SemanticLayerScheme"/>
        <dlo:safeCrossReservoirAggregation xml:lang="en">sum volume across defined dam membership; never average dam fill percentages</dlo:safeCrossReservoirAggregation>
        <dlo:safeTemporalAggregation xml:lang="en">first/last/min/max/change; never sum through time</dlo:safeTemporalAggregation>
      </skos:Concept>
    </dlo:semanticLayer>
