  <dlo:ColumnMapping rdf:about="https://w3id.org/damlevels/id/mapping/P2_observations/p2_rs_unresolved_prohibited">
    <rdfs:label>p2_rs_unresolved_prohibited (P2_observations)</rdfs:label>
    <rdfs:comment xml:lang="en">R.S. meaning unresolved; kept as raw text only, no variable asserted</rdfs:comment>
    <dlo:evidenceNote>PATCH_01_UNRESOLVED_SEMANTICS;03B</dlo:evidenceNote>
    <dlo:inRegime rdf:resource="https://w3id.org/damlevels/id/regime/P2_observations/2014-07-02_2025-10-10"/>
    <dlo:mappingConfidence>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/ConfidenceUnresolved">
        <skos:definition xml:lang="en">Meaning not established. No variable is asserted; values are kept only as printed text.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/ConfidenceScheme"/>
        <skos:notation>UNRESOLVED</skos:notation>
        <skos:prefLabel xml:lang="en">unresolved</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/ConfidenceScheme"/>
      </skos:Concept>
    </dlo:mappingConfidence>
    <dlo:semanticLayer>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/LayerSchemaDependent">
        <skos:definition xml:lang="en">Values whose mathematical behaviour is 'none'.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/SemanticLayerScheme"/>
        <skos:notation>schema_dependent</skos:notation>
        <skos:prefLabel xml:lang="en">schema dependent</skos:prefLabel>
