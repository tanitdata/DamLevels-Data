  <dlo:ColumnMapping rdf:about="https://w3id.org/damlevels/id/mapping/P2_observations/p2_apport_annuel_moyen_mm3">
    <rdfs:label>p2_apport_annuel_moyen_mm3 (P2_observations)</rdfs:label>
    <dlo:emissionMode rdf:resource="https://w3id.org/damlevels/code/EmitRunLength"/>
    <dlo:evidenceNote>PATCH_01</dlo:evidenceNote>
    <dlo:expectedUnit>
      <qudt:Unit rdf:about="https://w3id.org/damlevels/unit/MegaM3-PER-YR">
        <rdfs:label xml:lang="en">million cubic metres per year</rdfs:label>
        <rdfs:label xml:lang="fr">million de mètres cubes par an</rdfs:label>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.03168808781402895</qudt:conversionMultiplier>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T-1D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/VolumeFlowRate"/>
        <qudt:symbol>hm³/a</qudt:symbol>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">hm3/a</qudt:ucumCode>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
        <skos:altLabel>Mm³/a</skos:altLabel>
        <skos:definition xml:lang="en">Local unit: QUDT has no unit for 10^6 m³. Printed as 'Mm3' or 'Mm³' in the bulletins; the unambiguous symbol is hm³ (in SI notation Mm³ would mean cubic megametre). Conversion multiplier to the SI unit given with a Julian year (365.25 d) where a year is involved.</skos:definition>
      </qudt:Unit>
    </dlo:expectedUnit>
