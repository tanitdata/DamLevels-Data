    <dlo:temporalSupport>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/StateAtBulletinDate">
        <skos:closeMatch rdf:resource="http://vocabulary.odm2.org/aggregationstatistic/continuous/"/>
        <skos:closeMatch rdf:resource="http://www.opengis.net/def/waterml/2.0/interpolationType/Continuous"/>
        <skos:definition xml:lang="en">A state (volume, level, fill, remaining volume) that holds on the bulletin date D.</skos:definition>
