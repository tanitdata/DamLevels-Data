      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H09">
        <dcterms:description xml:lang="en">Δp1_release_cumul_year between consecutive bulletins equals p1_release_yesterday</dcterms:description>
        <dcterms:identifier>H09</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">tolerance 0.0015 Mm3 (3 rounding steps); resets excluded</rdfs:comment>
        <skos:note xml:lang="en">p1_release_cumul_year is a running total of p1_release_yesterday since season start, ending on day D2-1.</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">99.058</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">126155</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">124967</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
