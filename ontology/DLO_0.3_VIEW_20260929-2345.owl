    <rdf:type rdf:resource="https://w3id.org/damlevels/ontology/DayInstant"/>
    <time:inXSDDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-04-07</time:inXSDDate>
  </time:Instant>
  <owl:Class rdf:about="https://w3id.org/damlevels/ontology/ColumnMapping">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
    <rdfs:label xml:lang="en">column mapping</rdfs:label>
    <skos:definition xml:lang="en">The procedure that turns one printed column (or one Page 3 field at one grain) of one source table, inside one schema regime, into observations of one variable with one temporal support rule, one unit and one feature role. Every observation names the column mapping it was produced with (sosa:usedProcedure).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/"/>
  </owl:Class>
  <iop:Constraint rdf:about="https://w3id.org/damlevels/variable/LayerUpToMaximumLevel">
