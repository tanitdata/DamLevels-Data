  <skos:ConceptScheme rdf:about="https://w3id.org/damlevels/code/TemporalSupportScheme">
    <skos:definition xml:lang="en">How the phenomenon time of a printed value follows from the bulletin date D. Each rule names the corpus tests (dlo:supportedBy) or project decisions (dlo:evidenceNote) that support it, and is aligned to ODM2 aggregation statistics, OGC WaterML 2.0 interpolation types and CF cell_methods (close matches).</skos:definition>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/DayBeforeBulletin"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/EndOfPreviousHydrologicalYearState"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/LongTermMonthReference"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/LongTermSeasonToDateReference"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/LongTermStatic"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/MonthToDate"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/MultiYearSameDayReference"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/MultiYearSeasonToDateReference"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/PreviousFullHydrologicalYear"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/PreviousSeasonToDateUnresolved"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/PreviousYearSameDateState"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/PreviousYearSameDay"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/PreviousYearSeasonToDate"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/RegimeValueAsPrinted"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/SeasonToDate"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/StateAtBulletinDate"/>
    <skos:prefLabel xml:lang="en">temporal support rules</skos:prefLabel>
  </skos:ConceptScheme>
