    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H04">
        <dcterms:description xml:lang="en">p1_apport_cumul_prev_year(D) equals p1_apport_cumul_since_sep on the bulletin of the same calendar date one year earlier — previous-year season-to-date inflow</dcterms:description>
        <dcterms:identifier>H04</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">exact at printed precision; alternatives -365d: 74.4%, -366d: 54.9%, -364d: 32.7%, +1d: 39.6%, -1d: 41.5%</rdfs:comment>
        <skos:note xml:lang="en">Same calendar date is the best single offset, but mismatches cluster in dated periods (see H02c).</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">83.146</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">112428</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">93479</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H04c">
        <dcterms:description xml:lang="en">p1_apport_cumul_prev_year(D) equals p1_apport_cumul_since_sep on the bulletin of the per-bulletin reference date (calendar fitted on storage)</dcterms:description>
        <dcterms:identifier>H04c</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">out-of-sample check of the storage-fitted calendar; 710 of 3675 bulletins use a shifted reference; periods of 5+ bulletins: 2016-02-29..2016-03-05: +1 d; 2016-03-08..2016-06-16: +1 d; 2016-06-18..2016-07-13: +1 d; 2016-07-15..2016-09-02: +1 d; 2017-03-01..2017-07-23: -1 d; 2017-07-28..2017-09-04: -1 d; 2020-02-29..2020-06-01: +1 d; 2024-02-29..2024-03-20: +1 d; 2025-03-01..2025-10-10: -1 d</rdfs:comment>
        <skos:note xml:lang="en">The reference date is the same calendar date one year earlier, except in dated periods around leap years where the publisher used the same day of the year (+-1 day). The converter reads the per-bulletin reference date from PREVIOUS_YEAR_REFERENCE_CALENDAR.csv.</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">91.953</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">112780</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">103705</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29a"/>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29b"/>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29c"/>
    <dlo:temporalSupport rdf:resource="https://w3id.org/damlevels/code/PreviousYearSeasonToDate"/>
  </dlo:ColumnMapping>
