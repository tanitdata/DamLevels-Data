  <skos:ConceptScheme rdf:about="https://w3id.org/damlevels/code/ValueStatusScheme">
    <skos:definition xml:lang="en">What a printed cell contained.</skos:definition>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/AmbiguousTokenNoGuess">
        <skos:definition xml:lang="en">Characters were printed but could not be parsed without guessing; kept as printed text.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/ValueStatusScheme"/>
        <skos:notation>AMBIGUOUS_TOKEN_NO_GUESS</skos:notation>
        <skos:prefLabel xml:lang="en">ambiguous characters</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/ValueStatusScheme"/>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/NoValueInExtract"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/PresentNumeric"/>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/PresentText">
        <skos:definition xml:lang="en">The cell holds text instead of a number; the text is kept as printed.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/ValueStatusScheme"/>
        <skos:notation>PRESENT_TEXT</skos:notation>
        <skos:prefLabel xml:lang="en">printed text</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/ValueStatusScheme"/>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/PresentZero"/>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/SourceBlank">
        <skos:definition xml:lang="en">The cell was printed empty. A blank is never read as zero.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/ValueStatusScheme"/>
        <skos:notation>SOURCE_BLANK</skos:notation>
        <skos:prefLabel xml:lang="en">printed blank</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/ValueStatusScheme"/>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/SourceCorrectionCandidate">
        <skos:definition xml:lang="en">A printed value that looks like a typographic error; kept as printed and flagged, never corrected.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/ValueStatusScheme"/>
        <skos:notation>SOURCE_CORRECTION_CANDIDATE</skos:notation>
        <skos:prefLabel xml:lang="en">possible printing error</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/ValueStatusScheme"/>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/StructuralNotExpected"/>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/WithheldUnresolved">
        <skos:definition xml:lang="en">Characters were printed but the value is withheld because the reading could not be confirmed.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/ValueStatusScheme"/>
        <skos:notation>WITHHELD_UNRESOLVED</skos:notation>
        <skos:prefLabel xml:lang="en">withheld</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/ValueStatusScheme"/>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:prefLabel xml:lang="en">value status</skos:prefLabel>
  </skos:ConceptScheme>
