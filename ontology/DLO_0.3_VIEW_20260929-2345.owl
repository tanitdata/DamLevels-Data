      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H15">
        <dcterms:description xml:lang="en">p1_stock_fill_pct = 100 × p1_stock_today / p2_cap_actuelle (±0.05 pt, one printed decimal)</dcterms:description>
