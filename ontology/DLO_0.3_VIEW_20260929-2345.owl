    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29b"/>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29c"/>
    <dlo:temporalSupport>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/PreviousYearSeasonToDate">
        <skos:closeMatch rdf:resource="http://vocabulary.odm2.org/aggregationstatistic/cumulative/"/>
        <skos:closeMatch rdf:resource="http://www.opengis.net/def/waterml/2.0/interpolationType/InstantTotal"/>
        <skos:definition xml:lang="en">The season-to-date total as it stood on the reference bulletin one year earlier: from 1 September of hy(R(D)-1) to R(D)-1.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/TemporalSupportScheme"/>
        <skos:notation>PREVIOUS_YEAR_SEASON_TO_DATE</skos:notation>
        <skos:prefLabel xml:lang="en">running season total one year earlier</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/TemporalSupportScheme"/>
        <dlo:cfCellMethods>time: sum</dlo:cfCellMethods>
        <dlo:phenomenonTimePattern>interval(01-09-hy(R(D)-1) .. R(D))</dlo:phenomenonTimePattern>
        <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H04"/>
        <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H04c"/>
        <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H05"/>
        <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H05c"/>
      </skos:Concept>
    </dlo:temporalSupport>
