  <skos:ConceptScheme rdf:about="https://w3id.org/damlevels/code/SemanticLayerScheme">
    <skos:definition xml:lang="en">Mathematical behaviour classes of printed values: which temporal and cross-reservoir aggregations are safe (project registry PATCH_05).</skos:definition>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/LayerAuditOrQc">
        <skos:definition xml:lang="en">Values whose mathematical behaviour is 'none'.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/SemanticLayerScheme"/>
        <skos:notation>audit_or_qc</skos:notation>
        <skos:prefLabel xml:lang="en">audit or qc</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/SemanticLayerScheme"/>
        <dlo:safeCrossReservoirAggregation xml:lang="en">no physical aggregation</dlo:safeCrossReservoirAggregation>
        <dlo:safeTemporalAggregation xml:lang="en">retain as evidence</dlo:safeTemporalAggregation>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/LayerCumulativeCounter"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/LayerEventContext"/>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/LayerIdentity">
        <skos:definition xml:lang="en">Values whose mathematical behaviour is 'none'.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/SemanticLayerScheme"/>
        <skos:notation>identity</skos:notation>
        <skos:prefLabel xml:lang="en">identity</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/SemanticLayerScheme"/>
        <dlo:safeCrossReservoirAggregation xml:lang="en">join key only</dlo:safeCrossReservoirAggregation>
        <dlo:safeTemporalAggregation xml:lang="en">not a hydrological aggregation</dlo:safeTemporalAggregation>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/LayerIntervalFlux"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/LayerIntervalThroughput"/>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/LayerProvenance">
        <skos:definition xml:lang="en">Values whose mathematical behaviour is 'none'.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/SemanticLayerScheme"/>
        <skos:notation>provenance</skos:notation>
        <skos:prefLabel xml:lang="en">provenance</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/SemanticLayerScheme"/>
        <dlo:safeCrossReservoirAggregation xml:lang="en">lineage/filter only</dlo:safeCrossReservoirAggregation>
        <dlo:safeTemporalAggregation xml:lang="en">not a hydrological aggregation</dlo:safeTemporalAggregation>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/LayerReferenceValue"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/LayerRegimeParameter"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/LayerSchemaDependent"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/LayerState"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/damlevels/code/LayerStaticAttribute"/>
    <skos:prefLabel xml:lang="en">semantic layers</skos:prefLabel>
  </skos:ConceptScheme>
  <owl:Class rdf:about="http://www.w3.org/ns/dqv#Dimension">
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/dqv"/>
  </owl:Class>
  <dlo:Catchment rdf:about="https://w3id.org/damlevels/id/catchment/kasseb">
    <rdfs:label xml:lang="en">Kasseb catchment</rdfs:label>
    <dcterms:identifier>kasseb</dcterms:identifier>
    <skos:prefLabel xml:lang="fr">Bassin versant Kasseb</skos:prefLabel>
  </dlo:Catchment>
  <iop:AsymmetricSystem rdf:about="https://w3id.org/damlevels/variable/ReservoirToDownstreamSystemMovement">
    <rdfs:label xml:lang="en">water movement from Reservoir to DownstreamSystem</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
    <skos:definition xml:lang="en">The directed system in which water moves from a Reservoir (source) to a DownstreamSystem (target).</skos:definition>
    <iop:hasSource>
      <iop:Entity rdf:about="https://w3id.org/damlevels/variable/Reservoir">
        <rdfs:label xml:lang="en">reservoir</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000025"/>
        <skos:definition xml:lang="en">A reservoir as the source or target of a water movement.</skos:definition>
      </iop:Entity>
    </iop:hasSource>
    <iop:hasTarget>
      <iop:Entity rdf:about="https://w3id.org/damlevels/variable/DownstreamSystem">
        <rdfs:label xml:lang="en">downstream system</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
        <skos:definition xml:lang="en">The river reach, canal network or users that receive water released or withdrawn from a reservoir.</skos:definition>
      </iop:Entity>
    </iop:hasTarget>
  </iop:AsymmetricSystem>
  <dlo:Catchment rdf:about="https://w3id.org/damlevels/id/catchment/sidielbarrak">
    <rdfs:label xml:lang="en">Sidi El Barrak catchment</rdfs:label>
    <dcterms:identifier>sidielbarrak</dcterms:identifier>
    <skos:prefLabel xml:lang="fr">Bassin versant Sidi El Barrak</skos:prefLabel>
  </dlo:Catchment>
