  <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent">
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o"/>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/damlevels/ontology/DayInstant">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:label xml:lang="en">day-granular instant</rdfs:label>
    <skos:definition xml:lang="en">An instant known only to its day, described with time:inXSDDate: the daily reading of that day. A state printed on the bulletin of date D is observed at the day-granular instant D.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/damlevels/ontology/valueStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">value status</rdfs:label>
    <skos:definition xml:lang="en">What the printed cell contained (scheme dlc:ValueStatusScheme): a number, a zero, a blank, a text, a withheld value …</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/damlevels/ontology/BulletinObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/"/>
  </owl:ObjectProperty>
  <geo:Geometry rdf:about="https://w3id.org/damlevels/id/dam/kebir/geometry">
    <geo:asWKT rdf:datatype="http://www.opengis.net/ont/geosparql#wktLiteral">POINT(8.721591 36.880573)</geo:asWKT>
  </geo:Geometry>
  <owl:Class rdf:about="https://w3id.org/damlevels/ontology/SchemaRegime">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">schema regime</rdfs:label>
    <skos:definition xml:lang="en">A printed layout of a table that holds between two dates. A column has one meaning only inside a regime (for example Page 2 physical column 23 meant month-to-date inflow until 2024-04-26 and evaporation from 2024-04-27).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/"/>
  </owl:Class>
