  <iop:AsymmetricSystem rdf:about="https://w3id.org/damlevels/variable/ImpoundedWaterOverUsefulStorageSpace">
    <rdfs:label xml:lang="en">ImpoundedWater relative to UsefulStorageSpace</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
    <skos:definition xml:lang="en">The pair formed by ImpoundedWater (numerator) and UsefulStorageSpace (denominator) of a ratio.</skos:definition>
    <iop:hasDenominator>
      <iop:Entity rdf:about="https://w3id.org/damlevels/variable/UsefulStorageSpace">
        <rdfs:label xml:lang="en">useful storage space</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
        <skos:definition xml:lang="en">The part of the reservoir basin that can be used for storage and release.</skos:definition>
      </iop:Entity>
    </iop:hasDenominator>
    <iop:hasNumerator>
      <iop:Entity rdf:about="https://w3id.org/damlevels/variable/ImpoundedWater">
        <rdfs:label xml:lang="en">impounded water</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
        <skos:definition xml:lang="en">Water held in a reservoir behind a dam.</skos:definition>
      </iop:Entity>
    </iop:hasNumerator>
  </iop:AsymmetricSystem>
  <skos:ConceptScheme rdf:about="https://w3id.org/damlevels/code/EvidenceTypeScheme">
    <skos:definition xml:lang="en">Kinds of evidence used to compare printed values. They are kept apart because each proves something different (project registry PATCH_08).</skos:definition>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/EvidenceFormulaCheck">
        <skos:definition xml:lang="en">What it establishes: derived plausibility/comparison; not correction.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/EvidenceTypeScheme"/>
        <skos:notation>FORMULA_CHECK</skos:notation>
        <skos:prefLabel xml:lang="en">formula check</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Keep separate from: repeated reporting.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/EvidenceTypeScheme"/>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/EvidencePrintedChecksum">
        <skos:definition xml:lang="en">What it establishes: internal-document aggregate evidence; not physical truth label.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/EvidenceTypeScheme"/>
        <skos:notation>PRINTED_CHECKSUM</skos:notation>
        <skos:prefLabel xml:lang="en">printed checksum</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Keep separate from: physical equivalence.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/EvidenceTypeScheme"/>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/EvidenceReferenceLineage">
        <skos:definition xml:lang="en">What it establishes: historical/reference traceability.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/EvidenceTypeScheme"/>
        <skos:notation>REFERENCE_LINEAGE</skos:notation>
        <skos:prefLabel xml:lang="en">reference lineage</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Keep separate from: current measures.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/EvidenceTypeScheme"/>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/EvidenceRepeatedPageReporting">
        <skos:definition xml:lang="en">What it establishes: internal-document consistency only.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/EvidenceTypeScheme"/>
        <skos:notation>REPEATED_PAGE_REPORTING</skos:notation>
        <skos:prefLabel xml:lang="en">repeated page reporting</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Keep separate from: formula, reference, checksum.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/EvidenceTypeScheme"/>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:prefLabel xml:lang="en">evidence types</skos:prefLabel>
  </skos:ConceptScheme>
  <owl:Class rdf:about="https://w3id.org/damlevels/ontology/TransferRoute">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
    <rdfs:label xml:lang="en">transfer route</rdfs:label>
    <rdfs:label xml:lang="fr">adduction de transfert</rdfs:label>
    <skos:definition xml:lang="en">An engineered conveyance that carries water from one reservoir water body to another (Page 3 table T5 physical edges).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/"/>
  </owl:Class>
