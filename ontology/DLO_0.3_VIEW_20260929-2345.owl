    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
    <skos:definition xml:lang="en">Minimum over the stated period.</skos:definition>
  </iop:StatisticalModifier>
  <iop:Constraint rdf:about="https://w3id.org/damlevels/variable/ExploitablePart">
    <rdfs:label xml:lang="en">exploitable part</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/module/variables"/>
