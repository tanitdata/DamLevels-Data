  </dlo:Catchment>
  <owl:Class rdf:about="https://w3id.org/damlevels/ontology/RegionalReservoirGroup">
    <rdfs:subClassOf rdf:resource="https://w3id.org/damlevels/ontology/ReservoirAggregate"/>
    <rdfs:label xml:lang="en">regional reservoir group</rdfs:label>
    <rdfs:label xml:lang="fr">sous-total régional</rdfs:label>
    <skos:definition xml:lang="en">One of the three printed reservoir groups (North, Centre, Cap Bon). The Page 1 subtotal group, the Page 2 region heading and the Page 3 regional row denote the same group (tests H24, H29).</skos:definition>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/"/>
  </owl:Class>
