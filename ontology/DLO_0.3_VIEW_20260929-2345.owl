    <rdfs:label xml:lang="en">Lakhmess reservoir</rdfs:label>
    <dcterms:identifier>lakhmess</dcterms:identifier>
    <skos:prefLabel xml:lang="ar">لخمس</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Réservoir Lakhmess</skos:prefLabel>
    <dlo:hasDam>
      <dlo:Dam rdf:about="https://w3id.org/damlevels/id/dam/lakhmess">
        <rdfs:label xml:lang="en">Lakhmess Dam</rdfs:label>
        <dcterms:identifier>lakhmess</dcterms:identifier>
        <geo:hasGeometry rdf:resource="https://w3id.org/damlevels/id/dam/lakhmess/geometry"/>
