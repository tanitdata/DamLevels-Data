  <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H10">
    <dcterms:description xml:lang="en">p1_stock_today_mm3 equals Page 2 storage_current_total_corresponding_p2_mm3 (storage)</dcterms:description>
    <dcterms:identifier>H10</dcterms:identifier>
    <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
    <rdfs:comment xml:lang="en">exact at printed precision</rdfs:comment>
    <skos:note xml:lang="en">Same property and time; two observations from two pages; compare, never merge.</skos:note>
    <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
    <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P2_observations"/>
    <dqv:isMeasurementOf>
      <dqv:Metric rdf:about="https://w3id.org/damlevels/id/metric/semantic-support">
        <skos:prefLabel xml:lang="en">share of comparable cases supporting a semantic hypothesis</skos:prefLabel>
        <dqv:expectedDataType rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dqv:inDimension rdf:resource="https://w3id.org/damlevels/id/dimension/semantic-accuracy"/>
      </dqv:Metric>
    </dqv:isMeasurementOf>
    <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">99.999</dqv:value>
    <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">128996</dlo:comparedCases>
    <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
    <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">128995</dlo:supportingCases>
  </dlo:SemanticTest>
