  <owl:Class rdf:about="https://w3id.org/damlevels/ontology/BulletinObservation">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na7a34ae24882457197bca08ac9d1d760b14">
        <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/usedProcedure"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/damlevels/ontology/ColumnMapping"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na7a34ae24882457197bca08ac9d1d760b15">
        <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observedProperty"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/iadopt/ont/Variable"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na7a34ae24882457197bca08ac9d1d760b16">
        <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/hasFeatureOfInterest"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na7a34ae24882457197bca08ac9d1d760b17">
        <owl:onProperty rdf:resource="https://w3id.org/damlevels/ontology/valueStatus"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">bulletin observation</rdfs:label>
    <skos:definition xml:lang="en">One printed cell of a bulletin table (a number, a zero, a blank or a text) interpreted as an observation: one feature of interest, one I-ADOPT variable, one phenomenon time given by the temporal support rule of its column mapping, and at most one result.</skos:definition>
    <skos:scopeNote xml:lang="en">The same variable, feature and time printed on two pages gives two observations (repeated reporting). They are compared, never merged. When the temporal support is unresolved, no phenomenon time is asserted. Lineage: the observation prov:used the bulletin page it was read from; it is not declared a prov:Entity, so that it stays compatible with the SSN alignment of sosa:Observation to prov:Activity.</skos:scopeNote>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/damlevels/ontology/"/>
  </owl:Class>
