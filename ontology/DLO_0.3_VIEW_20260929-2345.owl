    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H25-inflow">
        <dcterms:description xml:lang="en">Page 3 national daily inflow equals the sum of the three regional rows (within 0.01 Mm3)</dcterms:description>
        <dcterms:identifier>H25-inflow</dcterms:identifier>
        <dcterms:source>analysis/test_aggregation_semantics.py</dcterms:source>
        <rdfs:comment xml:lang="en">before 2024-01-09: 3323/3324; from 2024-01-09: 638/638; within the strict rounding bound 0.002 Mm3: 2007/3962</rdfs:comment>
        <skos:note xml:lang="en">The three regions partition the national total to within 0.01 Mm3; the printed totals carry more precision or a rounding the printed regional values do not reproduce.</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P3_FACTS_LONG"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">99.975</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3962</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3961</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H25-withdrawal">
        <dcterms:description xml:lang="en">Page 3 national daily withdrawal equals the sum of the three regional rows (within 0.01 Mm3)</dcterms:description>
        <dcterms:identifier>H25-withdrawal</dcterms:identifier>
        <dcterms:source>analysis/test_aggregation_semantics.py</dcterms:source>
        <rdfs:comment xml:lang="en">before 2024-01-09: 3325/3325; from 2024-01-09: 626/636; within the strict rounding bound 0.002 Mm3: 2344/3961</rdfs:comment>
        <skos:note xml:lang="en">The three regions partition the national total to within 0.01 Mm3; the printed totals carry more precision or a rounding the printed regional values do not reproduce.</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P3_FACTS_LONG"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">99.748</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3961</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3951</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:temporalSupport rdf:resource="https://w3id.org/damlevels/code/DayBeforeBulletin"/>
  </dlo:ColumnMapping>
