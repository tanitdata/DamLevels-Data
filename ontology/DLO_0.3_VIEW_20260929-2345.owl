    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H02">
        <dcterms:description xml:lang="en">p1_stock_last_year_mm3(D) equals p1_stock_today_mm3 on the bulletin of the same calendar date one year earlier — previous-year storage</dcterms:description>
        <dcterms:identifier>H02</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">exact at printed precision; alternatives -365d: 77.5%, -366d: 55.8%, -364d: 30.1%, +1d: 37.6%, -1d: 41.0%</rdfs:comment>
        <skos:note xml:lang="en">Same calendar date is the best single offset, but mismatches cluster in dated periods (see H02c).</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">86.691</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">114415</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">99188</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H02c">
        <dcterms:description xml:lang="en">p1_stock_last_year_mm3(D) equals p1_stock_today_mm3 on the bulletin of the per-bulletin reference date (calendar fitted on storage)</dcterms:description>
        <dcterms:identifier>H02c</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">in-sample (the calendar is fitted on this column); 710 of 3675 bulletins use a shifted reference; periods of 5+ bulletins: 2016-02-29..2016-03-05: +1 d; 2016-03-08..2016-06-16: +1 d; 2016-06-18..2016-07-13: +1 d; 2016-07-15..2016-09-02: +1 d; 2017-03-01..2017-07-23: -1 d; 2017-07-28..2017-09-04: -1 d; 2020-02-29..2020-06-01: +1 d; 2024-02-29..2024-03-20: +1 d; 2025-03-01..2025-10-10: -1 d</rdfs:comment>
        <skos:note xml:lang="en">The reference date is the same calendar date one year earlier, except in dated periods around leap years where the publisher used the same day of the year (+-1 day). The converter reads the per-bulletin reference date from PREVIOUS_YEAR_REFERENCE_CALENDAR.csv.</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">99.493</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">114777</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">114195</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29a"/>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29b"/>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29c"/>
    <dlo:temporalSupport>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/PreviousYearSameDateState">
        <skos:closeMatch rdf:resource="http://vocabulary.odm2.org/aggregationstatistic/continuous/"/>
        <skos:closeMatch rdf:resource="http://www.opengis.net/def/waterml/2.0/interpolationType/Continuous"/>
        <skos:definition xml:lang="en">The same state variable at the reference date R(D) one year before D: the same calendar date, or the same day of the year (+-1 day) in dated periods around leap years (per-bulletin calendar, test H02c).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/TemporalSupportScheme"/>
        <skos:notation>PREVIOUS_YEAR_SAME_DATE_STATE</skos:notation>
        <skos:prefLabel xml:lang="en">state on the same date one year earlier</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/TemporalSupportScheme"/>
        <dlo:cfCellMethods>time: point</dlo:cfCellMethods>
        <dlo:phenomenonTimePattern>instant(R(D))</dlo:phenomenonTimePattern>
        <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H02"/>
        <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H02c"/>
      </skos:Concept>
    </dlo:temporalSupport>
  </dlo:ColumnMapping>
