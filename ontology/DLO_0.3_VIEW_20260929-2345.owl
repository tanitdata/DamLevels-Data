      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H26">
        <dcterms:description xml:lang="en">Page 3 national storage equals the sum of Page 1 storage over all dams printed that day (rounding bound)</dcterms:description>
        <dcterms:identifier>H26</dcterms:identifier>
        <dcterms:source>analysis/test_aggregation_semantics.py</dcterms:source>
        <rdfs:comment xml:lang="en">before 2024-01-09: 3305/3323; from 2024-01-09: 638/638; median |diff| = 0.001 Mm3</rdfs:comment>
        <skos:note xml:lang="en">The national total is an aggregate observation over the Page 1 roster; it is not a sum of Page 3 dam rows alone (row slots are unreadable).</skos:note>
