        <skos:closeMatch rdf:resource="http://vocabulary.odm2.org/aggregationstatistic/average/"/>
        <skos:closeMatch rdf:resource="http://www.opengis.net/def/waterml/2.0/interpolationType/TotalPrec"/>
        <skos:definition xml:lang="en">A climatological mean of the monthly total for the month of D-1. The phenomenon time is the representative month; the averaging years are unknown and carried by the statistical modifier.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/TemporalSupportScheme"/>
