    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H16">
        <dcterms:description xml:lang="en">p1_apport_average_period is non-decreasing inside a season (cumulative reference, not a flat average)</dcterms:description>
        <dcterms:identifier>H16</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">consecutive bulletins, season resets excluded</rdfs:comment>
        <skos:note xml:lang="en">Resolves the registry conflict: a long-term MEAN of the season-to-date total, i.e. a cumulative reference curve.</skos:note>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">99.819</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">126093</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">125865</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:supportedBy>
      <dlo:SemanticTest rdf:about="https://w3id.org/damlevels/id/test/H16b">
        <dcterms:description xml:lang="en">…and it is not constant within a season (rules out a single period mean)</dcterms:description>
        <dcterms:identifier>H16b</dcterms:identifier>
        <dcterms:source>analysis/test_semantic_hypotheses.py</dcterms:source>
        <rdfs:comment xml:lang="en">share of consecutive pairs where it changes</rdfs:comment>
        <dqv:computedOn rdf:resource="https://w3id.org/damlevels/id/source-table/P1_observations"/>
        <dqv:isMeasurementOf rdf:resource="https://w3id.org/damlevels/id/metric/semantic-support"/>
        <dqv:value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">96.836</dqv:value>
        <dlo:comparedCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">126093</dlo:comparedCases>
        <dlo:isNegativeControl rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</dlo:isNegativeControl>
        <dlo:supportingCases rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">122104</dlo:supportingCases>
      </dlo:SemanticTest>
    </dlo:supportedBy>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29a"/>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29b"/>
    <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H29c"/>
    <dlo:temporalSupport>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/LongTermSeasonToDateReference">
        <skos:closeMatch rdf:resource="http://vocabulary.odm2.org/aggregationstatistic/average/"/>
        <skos:closeMatch rdf:resource="http://www.opengis.net/def/waterml/2.0/interpolationType/InstantTotal"/>
        <skos:definition xml:lang="en">A climatological mean of the season-to-date total for the same span 1 September to D-1. The phenomenon time is the representative span; averaging years unknown.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/TemporalSupportScheme"/>
        <skos:notation>LONG_TERM_SEASON_TO_DATE_REFERENCE</skos:notation>
        <skos:prefLabel xml:lang="en">long-term mean of the season-to-date total</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/TemporalSupportScheme"/>
        <dlo:cfCellMethods>time: sum within years time: mean over years</dlo:cfCellMethods>
        <dlo:phenomenonTimePattern>interval(01-09-hy(D-1) .. D)</dlo:phenomenonTimePattern>
        <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H16"/>
        <dlo:supportedBy rdf:resource="https://w3id.org/damlevels/id/test/H16b"/>
      </skos:Concept>
    </dlo:temporalSupport>
