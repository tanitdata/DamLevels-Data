  <skos:ConceptScheme rdf:about="https://w3id.org/damlevels/code/OperationCodeScheme">
    <skos:definition xml:lang="en">Letters printed beside the Page 1 release. Meanings come from the project's registry (PATCH_11); no printed legend has been located, so every concept is provisional. Codes are case-sensitive.</skos:definition>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/OpDesilting">
        <vs:term_status>unstable</vs:term_status>
        <skos:definition xml:lang="en">Printed code 'd' (project registry confidence HIGH).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/OperationCodeScheme"/>
        <skos:notation>d</skos:notation>
        <skos:prefLabel xml:lang="en">desilting</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Provisional meaning: no printed legend located.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/OperationCodeScheme"/>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/OpDrainageLeakage">
        <vs:term_status>unstable</vs:term_status>
        <skos:definition xml:lang="en">Printed code 'p' (project registry confidence HIGH).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/OperationCodeScheme"/>
        <skos:notation>p</skos:notation>
        <skos:prefLabel xml:lang="en">drainage or leakage</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Provisional meaning: no printed legend located.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/OperationCodeScheme"/>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept>
      <skos:Concept rdf:about="https://w3id.org/damlevels/code/OpDrainageSourceVariant">
        <vs:term_status>unstable</vs:term_status>
        <skos:definition xml:lang="en">Printed code 'P' (project registry confidence MEDIUM).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/damlevels/code/OperationCodeScheme"/>
        <skos:notation>P</skos:notation>
        <skos:prefLabel xml:lang="en">drainage or source variant</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Provisional meaning: no printed legend located.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/damlevels/code/OperationCodeScheme"/>
      </skos:Concept>
    </skos:hasTopConcept>
    <skos:hasTopConcept>
