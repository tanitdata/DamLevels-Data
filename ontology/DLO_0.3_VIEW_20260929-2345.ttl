    rdfs:label "reservoir catchment"@en,
        "bassin versant"@fr ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf sosa:FeatureOfInterest,
        hyf:HY_Catchment ;
    skos:definition "The land area draining to the reservoir, as printed in the Page 2 'BV' column."@en .

<https://w3id.org/damlevels/id/time/2020-01-31/P1D> a time:ProperInterval,
