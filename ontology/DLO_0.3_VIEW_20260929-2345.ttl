dlo:DayInterval a owl:Class ;
    rdfs:label "interval of whole reporting days"@en ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf time:ProperInterval ;
    skos:definition "An interval of one or more whole reporting days (local calendar, Africa/Tunis). It begins at the day-granular instant of its first day and ends at the day-granular instant of the day after its last day, so that consecutive intervals meet and the daily amount printed on the bulletin of D ends at the state instant of D. time:hasXSDDuration gives the number of days. No clock time is asserted, because the bulletins print none."@en ;
    skos:scopeNote "Whether a reporting day runs from reading to reading (hydrological day) or from midnight to midnight is not printed; both readings give the same triples."@en .

time:ProperInterval a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
    rdfs:subClassOf time:Interval .

dlc:LayerReferenceValue a skos:Concept ;
    skos:definition "Values whose mathematical behaviour is 'as_of_reference'."@en ;
    skos:inScheme dlc:SemanticLayerScheme ;
    skos:notation "reference_value" ;
    skos:prefLabel "reference value"@en ;
    skos:topConceptOf dlc:SemanticLayerScheme ;
    dlo:safeCrossReservoirAggregation "no automatic network aggregation"@en ;
    dlo:safeTemporalAggregation "historical/reference comparison only"@en .

<https://w3id.org/damlevels/id/regime/P3_FACTS_LONG/2014-07-02_2025-10-10> a dlo:SchemaRegime ;
    rdfs:label "P3_FACTS_LONG layout 2014-07-02 to 2025-10-10"@en ;
    dlo:regimeValidFrom "2014-07-02"^^xsd:date ;
    dlo:regimeValidTo "2025-10-10"^^xsd:date .

dlc:IdentityUnresolvableTextRegime a skos:Concept ;
    skos:definition "The row's name text cannot be read in this layout; only its position is known."@en ;
    skos:inScheme dlc:IdentityStatusScheme ;
    skos:notation "IDENTITY_UNRESOLVABLE_TEXT_REGIME" ;
    skos:prefLabel "identity unresolvable text regime"@en ;
    skos:topConceptOf dlc:IdentityStatusScheme .

dlc:ConfidenceMedium a skos:Concept ;
    skos:definition "Accepted project registry reading, not contradicted, but not tested on the corpus or tested with partial support."@en ;
    skos:inScheme dlc:ConfidenceScheme ;
    skos:notation "MEDIUM" ;
    skos:prefLabel "medium"@en ;
    skos:topConceptOf dlc:ConfidenceScheme .

dlc:TemporalSupportScheme a skos:ConceptScheme ;
    skos:definition "How the phenomenon time of a printed value follows from the bulletin date D. Each rule names the corpus tests (dlo:supportedBy) or project decisions (dlo:evidenceNote) that support it, and is aligned to ODM2 aggregation statistics, OGC WaterML 2.0 interpolation types and CF cell_methods (close matches)."@en ;
    skos:hasTopConcept dlc:DayBeforeBulletin,
        dlc:EndOfPreviousHydrologicalYearState,
        dlc:LongTermMonthReference,
        dlc:LongTermSeasonToDateReference,
        dlc:LongTermStatic,
        dlc:MonthToDate,
        dlc:MultiYearSameDayReference,
        dlc:MultiYearSeasonToDateReference,
        dlc:PreviousFullHydrologicalYear,
        dlc:PreviousSeasonToDateUnresolved,
        dlc:PreviousYearSameDateState,
        dlc:PreviousYearSameDay,
        dlc:PreviousYearSeasonToDate,
        dlc:RegimeValueAsPrinted,
        dlc:SeasonToDate,
        dlc:StateAtBulletinDate ;
    skos:prefLabel "temporal support rules"@en .

dlv:ReleaseVolume a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "released water volume"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Lâchers"@fr,
