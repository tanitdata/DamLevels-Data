<https://w3id.org/damlevels/id/test/H06> a dlo:SemanticTest ;
    dcterms:description "Δp1_apport_cumul_this_month between consecutive bulletins equals p1_apport_today"@en ;
    dcterms:identifier "H06" ;
    dcterms:source "analysis/test_semantic_hypotheses.py" ;
    rdfs:comment "tolerance 0.0015 Mm3 (3 rounding steps); resets excluded"@en ;
    skos:note "p1_apport_cumul_this_month is a running total of p1_apport_today since month start, ending on day D2-1."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 99.510 ;
    dlo:comparedCases "122957"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "122354"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H07> a dlo:SemanticTest ;
    dcterms:description "Δp1_apport_cumul_since_sep between consecutive bulletins equals p1_apport_today"@en ;
    dcterms:identifier "H07" ;
    dcterms:source "analysis/test_semantic_hypotheses.py" ;
    rdfs:comment "tolerance 0.0015 Mm3 (3 rounding steps); resets excluded"@en ;
    skos:note "p1_apport_cumul_since_sep is a running total of p1_apport_today since season start, ending on day D2-1."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 97.080 ;
    dlo:comparedCases "126191"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "122506"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H08> a dlo:SemanticTest ;
    dcterms:description "Δp1_release_cumul_this_month between consecutive bulletins equals p1_release_yesterday"@en ;
    dcterms:identifier "H08" ;
    dcterms:source "analysis/test_semantic_hypotheses.py" ;
    rdfs:comment "tolerance 0.0015 Mm3 (3 rounding steps); resets excluded"@en ;
    skos:note "p1_release_cumul_this_month is a running total of p1_release_yesterday since month start, ending on day D2-1."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 99.562 ;
    dlo:comparedCases "122959"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "122420"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H09> a dlo:SemanticTest ;
    dcterms:description "Δp1_release_cumul_year between consecutive bulletins equals p1_release_yesterday"@en ;
    dcterms:identifier "H09" ;
    dcterms:source "analysis/test_semantic_hypotheses.py" ;
    rdfs:comment "tolerance 0.0015 Mm3 (3 rounding steps); resets excluded"@en ;
    skos:note "p1_release_cumul_year is a running total of p1_release_yesterday since season start, ending on day D2-1."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 99.058 ;
    dlo:comparedCases "126155"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "124967"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H16> a dlo:SemanticTest ;
    dcterms:description "p1_apport_average_period is non-decreasing inside a season (cumulative reference, not a flat average)"@en ;
    dcterms:identifier "H16" ;
    dcterms:source "analysis/test_semantic_hypotheses.py" ;
    rdfs:comment "consecutive bulletins, season resets excluded"@en ;
    skos:note "Resolves the registry conflict: a long-term MEAN of the season-to-date total, i.e. a cumulative reference curve."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 99.819 ;
    dlo:comparedCases "126093"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "125865"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H23> a dlo:SemanticTest ;
    dcterms:description "Water balance S(D2)-S(D2-1)-I(D2-1)+O(D2-1) closes within 0.01 Mm3 on consecutive bulletins"@en ;
    dcterms:identifier "H23" ;
    dcterms:source "analysis/test_semantic_hypotheses.py" ;
    rdfs:comment "informative; residual = evaporation, seepage, spills, transfers, reporting error"@en ;
    skos:note "Residual is a derived diagnostic, not a measured process."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 63.563 ;
    dlo:comparedCases "127192"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "80847"^^xsd:nonNegativeInteger .

