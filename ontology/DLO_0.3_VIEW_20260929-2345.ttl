    dlo:hasDam <https://w3id.org/damlevels/id/dam/bezirk> ;
    dlo:regionHeadingAsPrinted "cap_bon" ;
    dlo:storesWaterBody <https://w3id.org/damlevels/id/water-body/bezirk> .

<https://w3id.org/damlevels/id/test/H23b> a dlo:SemanticTest ;
    dcterms:description "NEGATIVE CONTROL: same balance with p1_release_today closes within 0.01 Mm3"@en ;
    dcterms:identifier "H23b" ;
    dcterms:source "analysis/test_semantic_hypotheses.py" ;
    rdfs:comment "should be clearly worse than H23"@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 42.872 ;
    dlo:comparedCases "127192"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl true ;
    dlo:supportingCases "54530"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H25-inflow> a dlo:SemanticTest ;
    dcterms:description "Page 3 national daily inflow equals the sum of the three regional rows (within 0.01 Mm3)"@en ;
    dcterms:identifier "H25-inflow" ;
    dcterms:source "analysis/test_aggregation_semantics.py" ;
    rdfs:comment "before 2024-01-09: 3323/3324; from 2024-01-09: 638/638; within the strict rounding bound 0.002 Mm3: 2007/3962"@en ;
    skos:note "The three regions partition the national total to within 0.01 Mm3; the printed totals carry more precision or a rounding the printed regional values do not reproduce."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations>,
        <https://w3id.org/damlevels/id/source-table/P3_FACTS_LONG> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 99.975 ;
    dlo:comparedCases "3962"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "3961"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/time/2025-10-11> a time:Instant,
        dlo:DayInstant ;
    time:inXSDDate "2025-10-11"^^xsd:date .

dlo:Bulletin a owl:Class ;
    rdfs:label "daily bulletin"@en,
        "bulletin quotidien"@fr ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The DGBGTH daily situation bulletin of one date: a logical publication made of up to three pages."@en .

dlo:ReservoirAggregate a owl:Class ;
    rdfs:label "reservoir aggregate"@en ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf sosa:FeatureOfInterest ;
    skos:definition "A set of managed reservoirs whose quantities are printed as one total. The value of an aggregate is an observation of the aggregate, not a sum asserted by this ontology; membership is recorded separately with its evidence."@en .

dlo:SourceTable a owl:Class ;
    rdfs:label "source table"@en ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A tabular output of an extraction run from which observations are converted (for example Page 1 observations)."@en .

dlv:InflowVolumeLongTermMean a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "long-term mean inflow volume"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Apports – moyenne"@fr ;
    skos:definition "Long-term mean of the inflow over a reference window (a month, or the season up to the same day)."@en ;
    skos:prefLabel "long-term mean inflow volume"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasContextObject dlv:CatchmentToReservoirMovement ;
    iop:hasObjectOfInterest dlv:Water ;
    iop:hasProperty dlv:Volume ;
    iop:hasStatisticalModifier dlv:LongTermMean .

iop:StatisticalModifier a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> .

dlc:MonthToDate a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/cumulative/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/InstantTotal> ;
    skos:definition "An amount accumulated from the first day of the month of D-1 to D-1 inclusive."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "MONTH_TO_DATE" ;
    skos:prefLabel "running total since the start of the month"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:cfCellMethods "time: sum" ;
    dlo:phenomenonTimePattern "interval(first-of-month(D-1) .. D)" ;
    dlo:supportedBy <https://w3id.org/damlevels/id/test/H06>,
        <https://w3id.org/damlevels/id/test/H08> .

<https://w3id.org/damlevels/id/bulletin/2025-10-10> dlo:hasPage <https://w3id.org/damlevels/id/page/74120c3aba8b889411cadc3f8d1c0446b2d3ce636d8da90f63ea605dcc5ecdab> .

