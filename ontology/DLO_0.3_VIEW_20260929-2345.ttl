    dcterms:description "Page 1 header 'du D1 observée le D2': D1 = D2 - 1 calendar day, also after bulletin gaps"@en ;
    dcterms:identifier "H01" ;
    dcterms:source "analysis/test_semantic_hypotheses.py" ;
    rdfs:comment "after-gap bulletins=74, all lag=1"@en ;
    skos:note "Interval quantities on a bulletin dated D2 refer to calendar day D2-1; states refer to D2."@en ;
