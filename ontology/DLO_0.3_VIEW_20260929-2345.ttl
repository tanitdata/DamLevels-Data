        dlc:LayerProvenance,
        dlc:LayerReferenceValue,
        dlc:LayerRegimeParameter,
        dlc:LayerSchemaDependent,
        dlc:LayerState,
        dlc:LayerStaticAttribute ;
    skos:prefLabel "semantic layers"@en .

<https://w3id.org/damlevels/id/regime/P2_observations/2014-07-02_2025-10-10> a dlo:SchemaRegime ;
