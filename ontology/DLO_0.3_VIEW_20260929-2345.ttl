<https://w3id.org/damlevels/id/test/H25-withdrawal> a dlo:SemanticTest ;
    dcterms:description "Page 3 national daily withdrawal equals the sum of the three regional rows (within 0.01 Mm3)"@en ;
    dcterms:identifier "H25-withdrawal" ;
    dcterms:source "analysis/test_aggregation_semantics.py" ;
    rdfs:comment "before 2024-01-09: 3325/3325; from 2024-01-09: 626/636; within the strict rounding bound 0.002 Mm3: 2344/3961"@en ;
    skos:note "The three regions partition the national total to within 0.01 Mm3; the printed totals carry more precision or a rounding the printed regional values do not reproduce."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations>,
        <https://w3id.org/damlevels/id/source-table/P3_FACTS_LONG> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 99.748 ;
    dlo:comparedCases "3961"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "3951"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H26> a dlo:SemanticTest ;
    dcterms:description "Page 3 national storage equals the sum of Page 1 storage over all dams printed that day (rounding bound)"@en ;
