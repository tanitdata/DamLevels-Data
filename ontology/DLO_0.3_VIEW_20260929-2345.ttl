dlo:accountsFor a owl:ObjectProperty ;
    rdfs:label "accounts for"@en ;
    rdfs:domain dlo:AccountingLine ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:ReservoirWaterBody ;
    skos:definition "The water body whose volume an accounting line reports."@en .

dlo:bulletinDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "bulletin date"@en ;
    rdfs:domain dlo:Bulletin ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:date ;
    skos:definition "The date printed as 'observée le' (date D2). States printed in the bulletin hold at this date; daily amounts cover the day before (H01)."@en .

dlo:canonicalUnit a owl:ObjectProperty ;
    rdfs:label "canonical unit"@en ;
    rdfs:domain iop:Variable ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range qudt:Unit ;
    skos:definition "The unit in which values of a variable are published."@en .

dlo:cfCellMethods a owl:AnnotationProperty ;
    rdfs:label "CF cell_methods equivalent"@en ;
    rdfs:isDefinedBy dlo: ;
    skos:definition "The equivalent CF Conventions cell_methods string for the time axis."@en .

dlo:comparedCases a owl:DatatypeProperty ;
    rdfs:label "compared cases"@en ;
    rdfs:domain dlo:SemanticTest ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Number of cases in the corpus where the hypothesis could be tested."@en .

dlo:drainedBy a owl:ObjectProperty ;
    rdfs:label "drained by catchment"@en ;
    rdfs:domain dlo:ReservoirWaterBody ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:Catchment ;
    skos:definition "Relates a reservoir water body to the catchment that drains into it."@en ;
    skos:note "Not a specialisation of hyf:containingCatchment, which nests catchments in catchments. In HY_Features terms the reservoir catchment is the catchment whose outflow nexus is the dam."@en .

dlo:emissionMode a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "emission mode"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range skos:Concept ;
    skos:definition "Whether one observation is made per printed value, or one per run of identical consecutive printed values (for values that are reprinted unchanged, such as capacities)."@en .

dlo:engineVersion a owl:DatatypeProperty ;
    rdfs:label "engine version"@en ;
    rdfs:domain dlo:ExtractionEngine ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:string ;
    skos:definition "Version string of the extraction engine."@en .

dlo:evidenceNote a owl:DatatypeProperty ;
    rdfs:label "evidence note"@en ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:string ;
    skos:definition "Identifiers of project decisions, registries or findings (ADR, PATCH, F-) that support a mapping."@en .

dlo:expectedUnit a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "expected unit"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range qudt:Unit ;
    skos:definition "The unit in which the values of this column are printed and published."@en .

dlo:featureRole a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "feature role"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range skos:Concept ;
    skos:definition "Which kind of feature the values of this mapping are about (scheme dlc:FeatureRoleScheme)."@en .

dlo:hasDam a owl:ObjectProperty ;
    rdfs:label "has dam"@en ;
    rdfs:domain dlo:ManagedReservoir ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:Dam ;
    skos:definition "Relates a managed reservoir to the dam that creates it."@en .

dlo:hasMemberReservoir a owl:ObjectProperty ;
    rdfs:label "has member reservoir"@en ;
    rdfs:domain dlo:ReservoirAggregate ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:ManagedReservoir ;
    skos:definition "Relates a reservoir aggregate to a managed reservoir whose values contribute to the aggregate's printed totals."@en ;
    skos:scopeNote "Asserted only when a test shows the printed total equals the sum of the members (H24, H26, H29)."@en .

dlo:hasPage a owl:ObjectProperty ;
    rdfs:label "has page"@en ;
    rdfs:domain dlo:Bulletin ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:BulletinPage ;
    skos:definition "Relates a bulletin to one of its page files."@en .

dlo:identityStatus a owl:ObjectProperty ;
    rdfs:label "identity status"@en ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range skos:Concept ;
    skos:definition "Whether and how the identity of a printed row (or of the row behind an observation) is established (scheme dlc:IdentityStatusScheme)."@en .

dlo:impounds a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "impounds"@en ;
    rdfs:domain dlo:Dam ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:ReservoirWaterBody ;
    skos:definition "Relates a dam to the water body it holds."@en .

dlo:inRegime a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "in schema regime"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:SchemaRegime ;
    skos:definition "The schema regime (dated layout) inside which this mapping holds."@en .

dlo:isNegativeControl a owl:DatatypeProperty ;
    rdfs:label "is negative control"@en ;
    rdfs:domain dlo:SemanticTest ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:boolean ;
    skos:definition "True when the test states a wrong reading on purpose; a low support confirms the method can reject."@en .

dlo:lastReportedIn a owl:ObjectProperty ;
    rdfs:label "last reported in bulletin"@en ;
    rdfs:domain dlo:BulletinObservation ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:Bulletin ;
    skos:definition "For a run-length observation, the last bulletin of the run of identical printed values."@en .

dlo:mappingConfidence a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "mapping confidence"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range skos:Concept ;
    skos:definition "How firmly the mapping is established (scheme dlc:ConfidenceScheme)."@en .

dlo:mapsToVariable a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "maps to variable"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range iop:Variable ;
    skos:definition "The I-ADOPT variable that the values of this column report."@en .

dlo:onPage a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "printed on page"@en ;
    rdfs:domain dlo:PrintedTable ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:BulletinPage ;
    skos:definition "Relates a printed table to the page file on which it is printed."@en .

dlo:pageNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "page number"@en ;
    rdfs:domain dlo:BulletinPage ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Position of the page in the bulletin: 1, 2 or 3."@en .

dlo:partOfAggregate a owl:ObjectProperty ;
    rdfs:label "part of aggregate"@en ;
    rdfs:domain dlo:RegionalReservoirGroup ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:NationalReservoirSystem ;
    skos:definition "Relates a regional group to the national system it partitions (H25)."@en .

dlo:phenomenonTimePattern a owl:AnnotationProperty ;
    rdfs:label "phenomenon time pattern"@en ;
    rdfs:isDefinedBy dlo: ;
    skos:definition "Formula that derives the phenomenon time from the bulletin date D (D-1 = the day before; hy(x) = year of the 1 September that starts the season of x)."@en .

dlo:previousYearReferenceDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "previous-year reference date"@en ;
    rdfs:domain dlo:Bulletin ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:date ;
    skos:definition "The date one year earlier to which the previous-year columns of this bulletin refer. It is the same calendar date, except in dated periods around leap years where the publisher used the same day of the year (+-1 day); fixed per bulletin by test H02c."@en .

dlo:printedText a owl:DatatypeProperty ;
    rdfs:label "printed text"@en ;
    rdfs:domain dlo:BulletinObservation ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:string ;
    skos:definition "The printed characters of a cell, kept when the cell is text, contested or unresolved."@en .

dlo:productDateRule a owl:DatatypeProperty ;
    rdfs:label "date rule stored by the source product"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:string ;
    skos:definition "The date rule written by the source table itself, kept as provenance when it differs from the verified temporal support (Page 3 stores SAME_DAY for all facts)."@en .

dlo:recoveryMethod a owl:DatatypeProperty ;
    rdfs:label "recovery method"@en ;
    rdfs:domain dlo:BulletinObservation ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:string ;
    skos:definition "Name of the audited reading method used when the default reader failed (Page 3 recovery)."@en .

dlo:regimeValidFrom a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "regime valid from"@en ;
    rdfs:domain dlo:SchemaRegime ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:date ;
    skos:definition "First bulletin date of the regime in the corpus (inclusive)."@en .

dlo:regimeValidTo a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "regime valid to"@en ;
    rdfs:domain dlo:SchemaRegime ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:date ;
    skos:definition "Last bulletin date of the regime in the corpus (inclusive)."@en .

dlo:regionHeadingAsPrinted a owl:DatatypeProperty ;
    rdfs:label "region heading as printed"@en ;
    rdfs:domain dlo:ManagedReservoir ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:string ;
    skos:definition "The Page 2 region heading under which a reservoir is printed, kept verbatim as evidence of group membership."@en .

dlo:repeatedReportingGroup a owl:DatatypeProperty ;
    rdfs:label "repeated reporting group"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:string ;
    skos:definition "Mappings with the same group code print the same variable, feature and time on different pages. Their observations are compared, never merged."@en .

dlo:reportedIn a owl:ObjectProperty ;
    rdfs:label "reported in bulletin"@en ;
    rdfs:domain dlo:BulletinObservation ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:Bulletin ;
    skos:definition "The bulletin in which the observation was printed (the first one for run-length observations)."@en .

dlo:reportedOperation a owl:ObjectProperty ;
    rdfs:label "reported operation"@en ;
    rdfs:domain dlo:BulletinObservation ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range skos:Concept ;
    skos:definition "An operation code printed beside the release (scheme dlc:OperationCodeScheme, provisional meanings)."@en .

dlo:routeSource a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "route source"@en ;
    rdfs:domain dlo:TransferRoute ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:ReservoirWaterBody ;
    skos:definition "The water body a transfer route takes water from."@en .

dlo:routeTarget a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "route target"@en ;
    rdfs:domain dlo:TransferRoute ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:ReservoirWaterBody ;
    skos:definition "The water body a transfer route delivers water to."@en .

dlo:rowPosition a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "row position"@en ;
    rdfs:domain dlo:PrintedRowSlot ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "1-based position of a printed row slot in its table."@en .

dlo:safeCrossReservoirAggregation a owl:AnnotationProperty ;
    rdfs:label "safe cross-reservoir aggregation"@en ;
    rdfs:isDefinedBy dlo: .

dlo:safeTemporalAggregation a owl:AnnotationProperty ;
    rdfs:label "safe temporal aggregation"@en ;
    rdfs:isDefinedBy dlo: .

dlo:semanticLayer a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "semantic layer"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range skos:Concept ;
    skos:definition "Mathematical behaviour class of the values: which aggregations are safe (scheme dlc:SemanticLayerScheme)."@en .

dlo:sha256 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "SHA-256 digest"@en ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:string ;
    skos:definition "Lower-case hexadecimal SHA-256 digest of a file (a bulletin page, or a source table)."@en .

dlo:sourceColumn a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "source column"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:string ;
    skos:definition "Column name in the source table (canonical field id for Page 3)."@en .

dlo:sourceConsistency a owl:ObjectProperty ;
    rdfs:label "source consistency"@en ;
    rdfs:domain dlo:BulletinObservation ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range skos:Concept ;
    skos:definition "Result of the printed-checksum check of the source row (scheme dlc:SourceConsistencyScheme)."@en .

dlo:sourceFileName a owl:DatatypeProperty ;
    rdfs:label "source file name"@en ;
    rdfs:domain dlo:BulletinPage ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:string ;
    skos:definition "File name of the page as distributed (no local path)."@en .

dlo:sourceGrain a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "source grain"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:string ;
    skos:definition "Row grain of a Page 3 fact (NATIONAL_DAY, DAM_DAY, ROW_SLOT_DAY, REGION_DAY, TRANSFER_EDGE_DAY, TRANSFER_ACCOUNTING_DAY, EXTERNAL_DELIVERY_DAY)."@en .

dlo:sourceTable a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "source table"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:SourceTable ;
    skos:definition "The extracted table whose column this mapping reads."@en .

dlo:storesWaterBody a owl:ObjectProperty ;
    rdfs:label "stores water body"@en ;
    rdfs:domain dlo:ManagedReservoir ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:ReservoirWaterBody ;
    rdfs:subPropertyOf hyf:storedWaterBody ;
    skos:definition "Relates a managed reservoir to the water body it stores (specialises HY_Features storedWaterBody)."@en .

dlo:supportedBy a owl:ObjectProperty ;
    rdfs:label "supported by test"@en ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range dlo:SemanticTest ;
    skos:definition "Relates a column mapping (or a membership decision) to an empirical test that supports it."@en .

dlo:supportingCases a owl:DatatypeProperty ;
    rdfs:label "supporting cases"@en ;
    rdfs:domain dlo:SemanticTest ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Number of compared cases that agree with the hypothesis."@en .

dlo:tableCode a owl:DatatypeProperty ;
    rdfs:label "table code"@en ;
    rdfs:domain dlo:PrintedTable ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:string ;
    skos:definition "Code of a printed table: P1, P1-SUBTOTALS, P2, P3-T1 ... P3-T6."@en .

dlo:temporalSupport a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "temporal support rule"@en ;
    rdfs:domain dlo:ColumnMapping ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range skos:Concept ;
    skos:definition "The rule that fixes the phenomenon time of every observation made with this mapping from the bulletin date (scheme dlc:TemporalSupportScheme)."@en .

dlo:timesPrinted a owl:DatatypeProperty ;
    rdfs:label "times printed"@en ;
    rdfs:domain dlo:BulletinObservation ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "For a run-length observation, the number of consecutive bulletins that printed the identical value."@en .

iop:SymmetricSystem a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> ;
    rdfs:subClassOf iop:System .

iop:constrains a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> .

iop:hasConstraint a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> .

iop:hasContextObject a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> .

iop:hasDenominator a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> .

iop:hasNumerator a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> .

iop:hasObjectOfInterest a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> .

iop:hasProperty a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> .

iop:hasSource a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> .

iop:hasStatisticalModifier a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> .

iop:hasTarget a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> .

obo:ENVO_00000074 a owl:Class ;
    rdfs:isDefinedBy obo:envo.owl .

time:Interval a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/2006/time> ;
    rdfs:subClassOf time:TemporalEntity .

dqv:Dimension a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dqv> .

dqv:Metric a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dqv> .

dqv:QualityMeasurement a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/ns/dqv> .

prov:Activity a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

prov:Agent a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

prov:SoftwareAgent a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> ;
    rdfs:subClassOf prov:Agent .

sosa:Observation a owl:Class ;
    rdfs:isDefinedBy sosa: .

sosa:ObservationCollection a owl:Class ;
    rdfs:isDefinedBy <https://w3c.github.io/sdw-sosa-ssn/ssn/> .

sosa:Procedure a owl:Class ;
    rdfs:isDefinedBy sosa: .

sosa:hasFeatureOfInterest a owl:ObjectProperty ;
    rdfs:isDefinedBy sosa: .

sosa:observedProperty a owl:ObjectProperty ;
    rdfs:isDefinedBy sosa: .

sosa:usedProcedure a owl:ObjectProperty ;
    rdfs:isDefinedBy sosa: .

dlc:AmbiguousTokenNoGuess a skos:Concept ;
    skos:definition "Characters were printed but could not be parsed without guessing; kept as printed text."@en ;
    skos:inScheme dlc:ValueStatusScheme ;
    skos:notation "AMBIGUOUS_TOKEN_NO_GUESS" ;
    skos:prefLabel "ambiguous characters"@en ;
    skos:topConceptOf dlc:ValueStatusScheme .

dlc:EvidenceFormulaCheck a skos:Concept ;
    skos:definition "What it establishes: derived plausibility/comparison; not correction."@en ;
    skos:inScheme dlc:EvidenceTypeScheme ;
    skos:notation "FORMULA_CHECK" ;
    skos:prefLabel "formula check"@en ;
    skos:scopeNote "Keep separate from: repeated reporting."@en ;
    skos:topConceptOf dlc:EvidenceTypeScheme .

dlc:EvidencePrintedChecksum a skos:Concept ;
    skos:definition "What it establishes: internal-document aggregate evidence; not physical truth label."@en ;
    skos:inScheme dlc:EvidenceTypeScheme ;
    skos:notation "PRINTED_CHECKSUM" ;
    skos:prefLabel "printed checksum"@en ;
    skos:scopeNote "Keep separate from: physical equivalence."@en ;
    skos:topConceptOf dlc:EvidenceTypeScheme .

dlc:EvidenceReferenceLineage a skos:Concept ;
    skos:definition "What it establishes: historical/reference traceability."@en ;
    skos:inScheme dlc:EvidenceTypeScheme ;
    skos:notation "REFERENCE_LINEAGE" ;
    skos:prefLabel "reference lineage"@en ;
    skos:scopeNote "Keep separate from: current measures."@en ;
    skos:topConceptOf dlc:EvidenceTypeScheme .

dlc:EvidenceRepeatedPageReporting a skos:Concept ;
    skos:definition "What it establishes: internal-document consistency only."@en ;
    skos:inScheme dlc:EvidenceTypeScheme ;
    skos:notation "REPEATED_PAGE_REPORTING" ;
    skos:prefLabel "repeated page reporting"@en ;
    skos:scopeNote "Keep separate from: formula, reference, checksum."@en ;
    skos:topConceptOf dlc:EvidenceTypeScheme .

dlc:IdentityNotApplicable a skos:Concept ;
    skos:definition "The row is an aggregate, a route or another non-reservoir feature."@en ;
    skos:inScheme dlc:IdentityStatusScheme ;
    skos:notation "IDENTITY_NOT_APPLICABLE" ;
    skos:prefLabel "identity not applicable"@en ;
    skos:topConceptOf dlc:IdentityStatusScheme .

dlc:IdentityResolved a skos:Concept ;
    skos:definition "The printed row is identified with a named reservoir."@en ;
    skos:inScheme dlc:IdentityStatusScheme ;
    skos:notation "IDENTITY_RESOLVED" ;
    skos:prefLabel "identity resolved"@en ;
    skos:topConceptOf dlc:IdentityStatusScheme .

dlc:IdentityResolvedRosterEntryCandidate a skos:Concept ;
    skos:definition "A candidate identity exists from the roster but is not confirmed (provisional)."@en ;
    skos:inScheme dlc:IdentityStatusScheme ;
    skos:notation "IDENTITY_RESOLVED_ROSTER_ENTRY_CANDIDATE" ;
    skos:prefLabel "identity resolved roster entry candidate"@en ;
    skos:topConceptOf dlc:IdentityStatusScheme .

dlc:LayerAuditOrQc a skos:Concept ;
    skos:definition "Values whose mathematical behaviour is 'none'."@en ;
    skos:inScheme dlc:SemanticLayerScheme ;
    skos:notation "audit_or_qc" ;
    skos:prefLabel "audit or qc"@en ;
    skos:topConceptOf dlc:SemanticLayerScheme ;
    dlo:safeCrossReservoirAggregation "no physical aggregation"@en ;
    dlo:safeTemporalAggregation "retain as evidence"@en .

dlc:LayerIdentity a skos:Concept ;
    skos:definition "Values whose mathematical behaviour is 'none'."@en ;
    skos:inScheme dlc:SemanticLayerScheme ;
    skos:notation "identity" ;
    skos:prefLabel "identity"@en ;
    skos:topConceptOf dlc:SemanticLayerScheme ;
    dlo:safeCrossReservoirAggregation "join key only"@en ;
    dlo:safeTemporalAggregation "not a hydrological aggregation"@en .

dlc:LayerProvenance a skos:Concept ;
    skos:definition "Values whose mathematical behaviour is 'none'."@en ;
    skos:inScheme dlc:SemanticLayerScheme ;
    skos:notation "provenance" ;
    skos:prefLabel "provenance"@en ;
    skos:topConceptOf dlc:SemanticLayerScheme ;
    dlo:safeCrossReservoirAggregation "lineage/filter only"@en ;
    dlo:safeTemporalAggregation "not a hydrological aggregation"@en .

dlc:OpDesilting a skos:Concept ;
    vs:term_status "unstable" ;
    skos:definition "Printed code 'd' (project registry confidence HIGH)."@en ;
    skos:inScheme dlc:OperationCodeScheme ;
    skos:notation "d" ;
    skos:prefLabel "desilting"@en ;
    skos:scopeNote "Provisional meaning: no printed legend located."@en ;
    skos:topConceptOf dlc:OperationCodeScheme .

dlc:OpDrainageLeakage a skos:Concept ;
    vs:term_status "unstable" ;
    skos:definition "Printed code 'p' (project registry confidence HIGH)."@en ;
    skos:inScheme dlc:OperationCodeScheme ;
    skos:notation "p" ;
    skos:prefLabel "drainage or leakage"@en ;
    skos:scopeNote "Provisional meaning: no printed legend located."@en ;
    skos:topConceptOf dlc:OperationCodeScheme .

dlc:OpDrainageSourceVariant a skos:Concept ;
    vs:term_status "unstable" ;
    skos:definition "Printed code 'P' (project registry confidence MEDIUM)."@en ;
    skos:inScheme dlc:OperationCodeScheme ;
    skos:notation "P" ;
    skos:prefLabel "drainage or source variant"@en ;
    skos:scopeNote "Provisional meaning: no printed legend located."@en ;
    skos:topConceptOf dlc:OperationCodeScheme .

dlc:OpOrdinaryRelease a skos:Concept ;
    vs:term_status "unstable" ;
    skos:definition "Printed code 'E' (project registry confidence HIGH)."@en ;
    skos:inScheme dlc:OperationCodeScheme ;
    skos:notation "E" ;
    skos:prefLabel "ordinary operation release"@en ;
    skos:scopeNote "Provisional meaning: no printed legend located."@en ;
    skos:topConceptOf dlc:OperationCodeScheme .

dlc:OpSpill a skos:Concept ;
    vs:term_status "unstable" ;
    skos:definition "Printed code 'D' (project registry confidence HIGH)."@en ;
    skos:inScheme dlc:OperationCodeScheme ;
    skos:notation "D" ;
    skos:prefLabel "spill or overflow"@en ;
    skos:scopeNote "Provisional meaning: no printed legend located."@en ;
    skos:topConceptOf dlc:OperationCodeScheme .

dlc:OpTransfer a skos:Concept ;
    vs:term_status "unstable" ;
    skos:definition "Printed code 'tr' (project registry confidence HIGH)."@en ;
    skos:inScheme dlc:OperationCodeScheme ;
    skos:notation "tr" ;
    skos:prefLabel "transfer"@en ;
    skos:scopeNote "Provisional meaning: no printed legend located."@en ;
    skos:topConceptOf dlc:OperationCodeScheme .

dlc:OpTurbining a skos:Concept ;
    vs:term_status "unstable" ;
    skos:definition "Printed code 'T' (project registry confidence HIGH)."@en ;
    skos:inScheme dlc:OperationCodeScheme ;
    skos:notation "T" ;
    skos:prefLabel "turbining"@en ;
    skos:scopeNote "Provisional meaning: no printed legend located."@en ;
    skos:topConceptOf dlc:OperationCodeScheme .

dlc:OpUnknownF a skos:Concept ;
    vs:term_status "unstable" ;
    skos:definition "Printed code 'f' (project registry confidence LOW)."@en ;
    skos:inScheme dlc:OperationCodeScheme ;
    skos:notation "f" ;
    skos:prefLabel "unknown code f"@en ;
    skos:scopeNote "Provisional meaning: no printed legend located."@en ;
    skos:topConceptOf dlc:OperationCodeScheme .

dlc:PresentText a skos:Concept ;
    skos:definition "The cell holds text instead of a number; the text is kept as printed."@en ;
    skos:inScheme dlc:ValueStatusScheme ;
    skos:notation "PRESENT_TEXT" ;
    skos:prefLabel "printed text"@en ;
    skos:topConceptOf dlc:ValueStatusScheme .

dlc:SourceArithmeticInconsistency a skos:Concept ;
    skos:definition "They differ beyond rounding: the bulletin itself is inconsistent."@en ;
    skos:inScheme dlc:SourceConsistencyScheme ;
    skos:notation "SOURCE_ARITHMETIC_INCONSISTENCY" ;
    skos:prefLabel "source arithmetic inconsistency"@en ;
    skos:topConceptOf dlc:SourceConsistencyScheme .

dlc:SourceBlank a skos:Concept ;
    skos:definition "The cell was printed empty. A blank is never read as zero."@en ;
    skos:inScheme dlc:ValueStatusScheme ;
    skos:notation "SOURCE_BLANK" ;
    skos:prefLabel "printed blank"@en ;
    skos:topConceptOf dlc:ValueStatusScheme .

dlc:SourceConsistent a skos:Concept ;
    skos:definition "The printed components add up to the printed total."@en ;
    skos:inScheme dlc:SourceConsistencyScheme ;
    skos:notation "SOURCE_CONSISTENT" ;
    skos:prefLabel "source consistent"@en ;
    skos:topConceptOf dlc:SourceConsistencyScheme .

dlc:SourceCorrectionCandidate a skos:Concept ;
    skos:definition "A printed value that looks like a typographic error; kept as printed and flagged, never corrected."@en ;
    skos:inScheme dlc:ValueStatusScheme ;
    skos:notation "SOURCE_CORRECTION_CANDIDATE" ;
    skos:prefLabel "possible printing error"@en ;
    skos:topConceptOf dlc:ValueStatusScheme .

dlc:SourceRoundingDifference a skos:Concept ;
    skos:definition "They differ only within rounding of the printed digits."@en ;
    skos:inScheme dlc:SourceConsistencyScheme ;
    skos:notation "SOURCE_ROUNDING_DIFFERENCE" ;
    skos:prefLabel "source rounding difference"@en ;
    skos:topConceptOf dlc:SourceConsistencyScheme .

dlc:WithheldUnresolved a skos:Concept ;
    skos:definition "Characters were printed but the value is withheld because the reading could not be confirmed."@en ;
    skos:inScheme dlc:ValueStatusScheme ;
    skos:notation "WITHHELD_UNRESOLVED" ;
    skos:prefLabel "withheld"@en ;
    skos:topConceptOf dlc:ValueStatusScheme .

