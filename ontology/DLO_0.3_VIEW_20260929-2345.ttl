<https://w3id.org/damlevels/id/test/H27c> a dlo:SemanticTest ;
    dcterms:description "p3_t3_inflow_difference_vs_3yr_mm3 = p3_t3_inflow_current_season_cum_mm3 - p3_t3_inflow_3yr_same_day_avg_mm3 (sign as printed)"@en ;
    dcterms:identifier "H27c" ;
    dcterms:source "analysis/test_aggregation_semantics.py" ;
    rdfs:comment "magnitude-only match: 368/368"@en ;
    skos:note "The printed difference is a derived observation (current minus comparator) with the comparator's temporal support."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P3_FACTS_LONG> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 100.000 ;
    dlo:comparedCases "368"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "368"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H27d> a dlo:SemanticTest ;
    dcterms:description "p3_t1_stock_3yr_same_day_avg_mm3 = mean of national storage on the same calendar date in the three previous years (tolerance 0.5 Mm3)"@en ;
    dcterms:identifier "H27d" ;
    dcterms:source "analysis/test_aggregation_semantics.py" ;
    rdfs:comment "median |diff| = 18.823 Mm3; Pearson r by year set {(1, 2, 3): 0.9918, (0, 1, 2): 0.7244, (2, 3, 4): 0.7297, (1, 2): 0.8724, (1,): 0.6678} (years 1-3 best); exact match fails: restated history and roster changes"@en ;
    skos:note "Comparator = multi-year same-day mean; phenomenon time is the representative date, the averaging years are carried by the statistical modifier."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P3_FACTS_LONG> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 14.045 ;
    dlo:comparedCases "2734"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "384"^^xsd:nonNegativeInteger .

