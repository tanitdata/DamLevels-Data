<https://w3id.org/damlevels/id/test/H24c-withdrawal> a dlo:SemanticTest ;
    dcterms:description "Page 3 REG-NORTH daily withdrawal equals the sum of Page 1 dams under the Page 2 heading 'nord'"@en ;
