dlo:PrintedTable a owl:Class ;
    rdfs:label "printed table"@en ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf prov:Entity,
        sosa:ObservationCollection ;
    skos:definition "One table printed on a bulletin page (Page 1 table, Page 2 table, Page 3 tables T1-T6). Its members are the observations read from its cells."@en .

dlv:DifferenceFromReference a iop:StatisticalModifier ;
    rdfs:label "difference from reference"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Current value minus its printed comparator (sign as printed)."@en .

dlv:Elevation a iop:Property ;
    rdfs:label "elevation"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:closeMatch qk:Length ;
    skos:definition "Height above the national vertical datum."@en .

dlv:HeadroomToMaximumLevel a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "remaining volume to maximum level"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "المتبقي للمستوى الأقصى"@ar ;
    skos:definition "Volume still available before the maximum level is reached, as printed on Page 3."@en ;
    skos:prefLabel "remaining volume to maximum level"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasConstraint dlv:LayerUpToMaximumLevel ;
    iop:hasObjectOfInterest dlv:ReservoirBasin ;
    iop:hasProperty dlv:Volume .

dlv:HeadroomToNormalLevel a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "remaining volume to normal pool level"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "المتبقي للمستوى العادي"@ar ;
    skos:definition "Volume still available before the normal pool level is reached, as printed on Page 3."@en ;
    skos:prefLabel "remaining volume to normal pool level"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasConstraint dlv:LayerUpToNormalPoolLevel ;
    iop:hasObjectOfInterest dlv:ReservoirBasin ;
    iop:hasProperty dlv:Volume .

dlv:InflowVolumeDifference a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "inflow volume minus reference"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "الفارق"@ar ;
    skos:definition "Printed difference between season-to-date inflow and a reference."@en ;
    skos:prefLabel "inflow volume minus reference"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasContextObject dlv:CatchmentToReservoirMovement ;
    iop:hasObjectOfInterest dlv:Water ;
    iop:hasProperty dlv:Volume ;
    iop:hasStatisticalModifier dlv:DifferenceFromReference .

dlv:MeanOverPreviousYears a iop:StatisticalModifier ;
    rdfs:label "mean over previous years"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Mean over the three previous years at the same calendar date or span."@en .

dlv:ModelEstimate a iop:StatisticalModifier ;
    rdfs:label "model estimate"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Estimated by a model or formula rather than measured."@en .

dlv:Ratio a iop:Property ;
    rdfs:label "ratio"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:closeMatch qk:VolumeFraction ;
    skos:definition "A quotient of two quantities of the same kind, expressed in percent."@en .

dlv:UsefulPart a iop:Constraint ;
    rdfs:label "useful part"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Restricts the basin to its useful (exploitable) storage."@en ;
    iop:constrains dlv:ReservoirBasin .

dlv:WaterSurfaceElevation a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "water surface elevation"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Cote plan d'eau"@fr ;
    skos:definition "Elevation of the reservoir water surface above the national datum (metres)."@en ;
    skos:prefLabel "water surface elevation"@en ;
    dlo:canonicalUnit unit:M ;
    iop:hasObjectOfInterest dlv:WaterSurface ;
    iop:hasProperty dlv:Elevation .

dlv:WithdrawalVolume a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "withdrawal volume (Page 3)"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "السحب"@ar ;
    skos:definition "Page 3 withdrawals. Equal to summed Page 1 releases until 2024-01-08; different regime afterwards (F-015)."@en ;
    skos:prefLabel "withdrawal volume (Page 3)"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasContextObject dlv:ReservoirToDownstreamSystemMovement ;
    iop:hasObjectOfInterest dlv:Water ;
    iop:hasProperty dlv:Volume .

iop:System a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> ;
    rdfs:subClassOf iop:Entity .

dlc:EndOfPreviousHydrologicalYearState a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/continuous/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/Continuous> ;
    skos:definition "A state read on the 1 September bulletin that opened the current season, i.e. at 1 September of hy(D-1). Reprinted unchanged all season."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "END_OF_PREVIOUS_HYDROLOGICAL_YEAR_STATE" ;
    skos:prefLabel "state at the close of the previous hydrological year"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:cfCellMethods "time: point" ;
    dlo:phenomenonTimePattern "instant(01-09-hy(D-1))" ;
    dlo:supportedBy <https://w3id.org/damlevels/id/test/H18>,
        <https://w3id.org/damlevels/id/test/H19> .

dlc:LongTermMonthReference a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/average/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/TotalPrec> ;
    skos:definition "A climatological mean of the monthly total for the month of D-1. The phenomenon time is the representative month; the averaging years are unknown and carried by the statistical modifier."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "LONG_TERM_MONTH_REFERENCE" ;
    skos:prefLabel "long-term mean for the calendar month"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:cfCellMethods "time: sum within years time: mean over years" ;
    dlo:phenomenonTimePattern "interval(first-of-month(D-1) .. first-of-next-month)" ;
    dlo:supportedBy <https://w3id.org/damlevels/id/test/H17> .

dlc:MultiYearSeasonToDateReference a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/average/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/InstantTotal> ;
    skos:definition "The mean of the season-to-date total for the same span in the three previous years (Page 3 T3, printed until 2015-10-01). The phenomenon time is the representative span."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "MULTI_YEAR_SEASON_TO_DATE_REFERENCE" ;
    skos:prefLabel "mean season-to-date total over the three previous years"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:cfCellMethods "time: sum within years time: mean over years" ;
    dlo:phenomenonTimePattern "interval(01-09-hy(D-1) .. D)" ;
    dlo:supportedBy <https://w3id.org/damlevels/id/test/H27c> .

dlc:PreviousFullHydrologicalYear a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/incremental/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/TotalPrec> ;
    skos:definition "An amount over the whole previous season, 1 September of hy(D-1)-1 to 31 August of hy(D-1), as printed on the 1 September bulletin."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "PREVIOUS_FULL_HYDROLOGICAL_YEAR" ;
    skos:prefLabel "total over the previous hydrological year"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:cfCellMethods "time: sum" ;
    dlo:phenomenonTimePattern "interval(01-09-(hy(D-1)-1) .. 01-09-hy(D-1))" ;
    dlo:supportedBy <https://w3id.org/damlevels/id/test/H20>,
        <https://w3id.org/damlevels/id/test/H21> .

dlc:PreviousYearSameDateState a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/continuous/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/Continuous> ;
    skos:definition "The same state variable at the reference date R(D) one year before D: the same calendar date, or the same day of the year (+-1 day) in dated periods around leap years (per-bulletin calendar, test H02c)."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "PREVIOUS_YEAR_SAME_DATE_STATE" ;
    skos:prefLabel "state on the same date one year earlier"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:cfCellMethods "time: point" ;
    dlo:phenomenonTimePattern "instant(R(D))" ;
    dlo:supportedBy <https://w3id.org/damlevels/id/test/H02>,
        <https://w3id.org/damlevels/id/test/H02c> .

dlc:PreviousYearSameDay a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/incremental/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/TotalPrec> ;
    skos:definition "The same daily amount for the day before R(D), i.e. the daily amount printed on the reference bulletin one year earlier."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "PREVIOUS_YEAR_SAME_DAY" ;
    skos:prefLabel "amount over the same day one year earlier"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:cfCellMethods "time: sum" ;
    dlo:phenomenonTimePattern "interval(R(D)-1 .. R(D))" ;
    dlo:supportedBy <https://w3id.org/damlevels/id/test/H03>,
        <https://w3id.org/damlevels/id/test/H03c>,
        <https://w3id.org/damlevels/id/test/H13>,
        <https://w3id.org/damlevels/id/test/H23b> .

dlc:RoleCatchment a skos:Concept ;
    rdfs:seeAlso dlo:Catchment ;
    skos:definition "Values are about a feature of class dlo:Catchment."@en ;
    skos:inScheme dlc:FeatureRoleScheme ;
    skos:notation "CATCHMENT" ;
    skos:prefLabel "catchment"@en ;
    skos:topConceptOf dlc:FeatureRoleScheme .

dlc:RoleRegion a skos:Concept ;
    rdfs:seeAlso dlo:RegionalReservoirGroup ;
    skos:definition "Values are about a feature of class dlo:RegionalReservoirGroup."@en ;
    skos:inScheme dlc:FeatureRoleScheme ;
    skos:notation "REGION" ;
    skos:prefLabel "region"@en ;
    skos:topConceptOf dlc:FeatureRoleScheme .

dlc:StructuralNotExpected a skos:Concept ;
    skos:definition "The table layout of that date has no such cell."@en ;
    skos:inScheme dlc:ValueStatusScheme ;
    skos:notation "STRUCTURAL_NOT_EXPECTED" ;
    skos:prefLabel "not in layout"@en ;
    skos:topConceptOf dlc:ValueStatusScheme .

