    rdfs:comment "before 2024-01-09: 3316/3324; from 2024-01-09: 25/638"@en ;
    skos:note "Region membership is evidence-qualified: asserted only where the sum closes; otherwise the Page 2 heading is kept as printed context."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations>,
        <https://w3id.org/damlevels/id/source-table/P3_FACTS_LONG> ;
