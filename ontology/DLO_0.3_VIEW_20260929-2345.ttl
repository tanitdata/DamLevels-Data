        "sous-total régional"@fr ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf dlo:ReservoirAggregate ;
    skos:definition "One of the three printed reservoir groups (North, Centre, Cap Bon). The Page 1 subtotal group, the Page 2 region heading and the Page 3 regional row denote the same group (tests H24, H29)."@en .

dlu:MegaM3-PER-YR a qudt:Unit ;
    rdfs:label "million cubic metres per year"@en,
        "million de mètres cubes par an"@fr ;
    qudt:conversionMultiplier 0.03168808781402895 ;
    qudt:hasDimensionVector qkdv:A0E0L3I0M0H0T-1D0 ;
    qudt:hasQuantityKind qk:VolumeFlowRate ;
    qudt:symbol "hm³/a" ;
    qudt:ucumCode "hm3/a"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Mm³/a" ;
    skos:definition "Local unit: QUDT has no unit for 10^6 m³. Printed as 'Mm3' or 'Mm³' in the bulletins; the unambiguous symbol is hm³ (in SI notation Mm³ would mean cubic megametre). Conversion multiplier to the SI unit given with a Julian year (365.25 d) where a year is involved."@en .

dlv:ImpoundedWater a iop:Entity ;
    rdfs:label "impounded water"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Water held in a reservoir behind a dam."@en .

dlv:Reservoir a iop:Entity ;
    rdfs:label "reservoir"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:closeMatch obo:ENVO_00000025 ;
    skos:definition "A reservoir as the source or target of a water movement."@en .

dlc:LongTermStatic a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/constantOverInterval/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/ConstPrec> ;
    skos:definition "A design or long-term attribute reprinted on every bulletin. One observation per run of identical values; the phenomenon time is the span of bulletins that printed it."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "LONG_TERM_STATIC" ;
    skos:prefLabel "static attribute reprinted unchanged"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:evidenceNote "PATCH_01" ;
    dlo:phenomenonTimePattern "interval(first D of run .. day after last D of run)" .

