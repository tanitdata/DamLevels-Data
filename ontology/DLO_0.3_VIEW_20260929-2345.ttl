<https://w3id.org/damlevels/id/test/H02> a dlo:SemanticTest ;
    dcterms:description "p1_stock_last_year_mm3(D) equals p1_stock_today_mm3 on the bulletin of the same calendar date one year earlier — previous-year storage"@en ;
    dcterms:identifier "H02" ;
    dcterms:source "analysis/test_semantic_hypotheses.py" ;
    rdfs:comment "exact at printed precision; alternatives -365d: 77.5%, -366d: 55.8%, -364d: 30.1%, +1d: 37.6%, -1d: 41.0%"@en ;
    skos:note "Same calendar date is the best single offset, but mismatches cluster in dated periods (see H02c)."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 86.691 ;
    dlo:comparedCases "114415"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "99188"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H02c> a dlo:SemanticTest ;
    dcterms:description "p1_stock_last_year_mm3(D) equals p1_stock_today_mm3 on the bulletin of the per-bulletin reference date (calendar fitted on storage)"@en ;
    dcterms:identifier "H02c" ;
    dcterms:source "analysis/test_semantic_hypotheses.py" ;
    rdfs:comment "in-sample (the calendar is fitted on this column); 710 of 3675 bulletins use a shifted reference; periods of 5+ bulletins: 2016-02-29..2016-03-05: +1 d; 2016-03-08..2016-06-16: +1 d; 2016-06-18..2016-07-13: +1 d; 2016-07-15..2016-09-02: +1 d; 2017-03-01..2017-07-23: -1 d; 2017-07-28..2017-09-04: -1 d; 2020-02-29..2020-06-01: +1 d; 2024-02-29..2024-03-20: +1 d; 2025-03-01..2025-10-10: -1 d"@en ;
    skos:note "The reference date is the same calendar date one year earlier, except in dated periods around leap years where the publisher used the same day of the year (+-1 day). The converter reads the per-bulletin reference date from PREVIOUS_YEAR_REFERENCE_CALENDAR.csv."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 99.493 ;
    dlo:comparedCases "114777"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "114195"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H03> a dlo:SemanticTest ;
    dcterms:description "p1_release_today(D) equals p1_release_yesterday on the bulletin of the same calendar date one year earlier — previous-year interval release"@en ;
    dcterms:identifier "H03" ;
    dcterms:source "analysis/test_semantic_hypotheses.py" ;
    rdfs:comment "exact at printed precision; alternatives -365d: 86.2%, -366d: 72.4%, -364d: 59.3%, +1d: 63.1%, -1d: 63.9%"@en ;
