dlo:TransferRoute a owl:Class ;
    rdfs:label "transfer route"@en,
        "adduction de transfert"@fr ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf sosa:FeatureOfInterest ;
    skos:definition "An engineered conveyance that carries water from one reservoir water body to another (Page 3 table T5 physical edges)."@en .

dlv:CatchmentToReservoirMovement a iop:AsymmetricSystem ;
    rdfs:label "water movement from Catchment to Reservoir"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The directed system in which water moves from a Catchment (source) to a Reservoir (target)."@en ;
    iop:hasSource dlv:Catchment ;
    iop:hasTarget dlv:Reservoir .

iop:AsymmetricSystem a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/iadopt/ont> ;
    rdfs:subClassOf iop:System .

dlc:ConfidenceLow a skos:Concept ;
    skos:definition "Contested or partly unresolved reading. The mapping is kept so the values stay usable, and it is flagged."@en ;
    skos:inScheme dlc:ConfidenceScheme ;
    skos:notation "LOW" ;
    skos:prefLabel "low"@en ;
    skos:topConceptOf dlc:ConfidenceScheme .

dlc:ConfidenceScheme a skos:ConceptScheme ;
    skos:definition "How firmly a column mapping is established."@en ;
    skos:hasTopConcept dlc:ConfidenceHigh,
        dlc:ConfidenceLow,
        dlc:ConfidenceMedium,
        dlc:ConfidenceUnresolved ;
    skos:prefLabel "mapping confidence"@en .

dlc:EvidenceTypeScheme a skos:ConceptScheme ;
    skos:definition "Kinds of evidence used to compare printed values. They are kept apart because each proves something different (project registry PATCH_08)."@en ;
    skos:hasTopConcept dlc:EvidenceFormulaCheck,
        dlc:EvidencePrintedChecksum,
        dlc:EvidenceReferenceLineage,
        dlc:EvidenceRepeatedPageReporting ;
    skos:prefLabel "evidence types"@en .

dlc:IdentityStatusScheme a skos:ConceptScheme ;
    skos:definition "Whether the reservoir behind a printed row is identified."@en ;
    skos:hasTopConcept dlc:IdentityNotApplicable,
        dlc:IdentityResolved,
        dlc:IdentityResolvedRosterEntryCandidate,
        dlc:IdentityUnresolvableTextRegime ;
    skos:prefLabel "identity status"@en .

dlc:LayerIntervalThroughput a skos:Concept ;
    skos:definition "Values whose mathematical behaviour is 'sum'."@en ;
    skos:inScheme dlc:SemanticLayerScheme ;
    skos:notation "interval_throughput" ;
    skos:prefLabel "interval throughput"@en ;
    skos:topConceptOf dlc:SemanticLayerScheme ;
    dlo:safeCrossReservoirAggregation "sum with network membership and coverage"@en ;
    dlo:safeTemporalAggregation "sum compatible intervals with operation coverage"@en .

dlc:LayerRegimeParameter a skos:Concept ;
    skos:definition "Values whose mathematical behaviour is 'as_of'."@en ;
    skos:inScheme dlc:SemanticLayerScheme ;
    skos:notation "regime_parameter" ;
    skos:prefLabel "regime parameter"@en ;
    skos:topConceptOf dlc:SemanticLayerScheme ;
    dlo:safeCrossReservoirAggregation "aggregate only with a defined physical formula"@en ;
    dlo:safeTemporalAggregation "date-effective as-of join; preserve regime boundaries"@en .

dlc:RegimeValueAsPrinted a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/constantOverInterval/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/ConstPrec> ;
    skos:definition "A value that holds until the operator reprints a new one (capacities, sedimentation from surveys). One observation per run of identical values; the phenomenon time is the span of bulletins that printed it."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "REGIME_VALUE_AS_PRINTED" ;
    skos:prefLabel "value in force for a regime"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:evidenceNote "ADR-011" ;
    dlo:phenomenonTimePattern "interval(first D of run .. day after last D of run)" .

dlc:SourceConsistencyScheme a skos:ConceptScheme ;
    skos:definition "Outcome of checking a printed row against the printed totals of its table."@en ;
    skos:hasTopConcept dlc:NotChecked,
        dlc:SourceArithmeticInconsistency,
        dlc:SourceConsistent,
        dlc:SourceRoundingDifference ;
    skos:prefLabel "source consistency"@en .

