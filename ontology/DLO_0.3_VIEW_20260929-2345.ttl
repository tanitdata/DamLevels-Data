dlo:valueStatus a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "value status"@en ;
    rdfs:domain dlo:BulletinObservation ;
    rdfs:isDefinedBy dlo: ;
    rdfs:range skos:Concept ;
    skos:definition "What the printed cell contained (scheme dlc:ValueStatusScheme): a number, a zero, a blank, a text, a withheld value …"@en .

dlv:AccountingDefinition a iop:Constraint ;
    rdfs:label "accounting definition"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Volume counted under a bookkeeping definition that includes transferred water; not a physical flow."@en ;
    iop:constrains dlv:Water .

dlv:Area a iop:Property ;
    rdfs:label "area"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:closeMatch qk:Area ;
    skos:definition "Extent of a surface."@en .

dlv:AtCommissioning a iop:Constraint ;
    rdfs:label "at commissioning"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "As designed or measured at commissioning."@en ;
    iop:constrains dlv:ReservoirBasin .

dlv:Atmosphere a iop:Entity ;
    rdfs:label "atmosphere"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The air above the reservoir, which receives evaporated water."@en .

dlv:CatchmentArea a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "catchment area"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Bassin versant (BV)"@fr ;
    skos:definition "Area of the drainage basin."@en ;
    skos:prefLabel "catchment area"@en ;
    dlo:canonicalUnit unit:KiloM2 ;
    iop:hasObjectOfInterest dlv:Catchment ;
    iop:hasProperty dlv:Area .

dlv:CatchmentErosionRate a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "equivalent catchment erosion"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Erosion (mm/an)"@fr ;
    skos:definition "Sediment yield expressed as equivalent soil depth per year."@en ;
    skos:prefLabel "equivalent catchment erosion"@en ;
    dlo:canonicalUnit unit:MilliM-PER-YR ;
    iop:hasContextObject dlv:Catchment ;
    iop:hasObjectOfInterest dlv:Soil ;
    iop:hasProperty dlv:DepthRate ;
    iop:hasStatisticalModifier dlv:LongTermMean .

dlv:DamSite a iop:Entity ;
    rdfs:label "dam site"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The location of the dam, where the rain gauge stands."@en .

dlv:Depth a iop:Property ;
    rdfs:label "depth"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:closeMatch qk:Length ;
    skos:definition "A length measured vertically, for example precipitation depth."@en .

dlv:DepthRate a iop:Property ;
    rdfs:label "depth rate"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:closeMatch qk:Speed ;
    skos:definition "A depth per year."@en .

dlv:DischargeRate a iop:Property ;
    rdfs:label "discharge rate"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:closeMatch qk:VolumeFlowRate ;
    skos:definition "A volume per unit time passing a section."@en .

dlv:DownstreamSystem a iop:Entity ;
    rdfs:label "downstream system"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The river reach, canal network or users that receive water released or withdrawn from a reservoir."@en .

dlv:EstimatedUsefulCapacity a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "estimated useful capacity after post-survey sedimentation"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Capacité utile calculée"@fr ;
    skos:definition "Useful capacity reduced by annual sedimentation since the survey."@en ;
    skos:prefLabel "estimated useful capacity after post-survey sedimentation"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasConstraint dlv:UsefulPart ;
    iop:hasObjectOfInterest dlv:ReservoirBasin ;
    iop:hasProperty dlv:Volume ;
    iop:hasStatisticalModifier dlv:ModelEstimate .

dlv:EvaporatedVolume a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "evaporated volume"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Volume évaporé"@fr ;
    skos:definition "Volume lost by evaporation over the reporting interval (printed from 2024-04-27)."@en ;
    skos:prefLabel "evaporated volume"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasConstraint dlv:EvaporationProcess ;
    iop:hasContextObject dlv:ReservoirToAtmosphereMovement ;
    iop:hasObjectOfInterest dlv:Water ;
    iop:hasProperty dlv:Volume .

dlv:EvaporationProcess a iop:Constraint ;
    rdfs:label "evaporation process"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Restricts the water loss to the part lost by evaporation."@en ;
    iop:constrains dlv:Water .

dlv:ExploitablePart a iop:Constraint ;
    rdfs:label "exploitable part"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Restricts the stored water to the part the operator reports as usable."@en ;
    iop:constrains dlv:ImpoundedWater .

dlv:ExploitableStoredWaterVolume a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "exploitable stored water volume"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Volume utilisable/exploitable"@fr ;
    skos:definition "Part of the stored volume the operator reports as usable/exploitable."@en ;
    skos:prefLabel "exploitable stored water volume"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasConstraint dlv:ExploitablePart ;
    iop:hasObjectOfInterest dlv:ImpoundedWater ;
    iop:hasProperty dlv:Volume .

dlv:ExternalDestination a iop:Entity ;
    rdfs:label "external destination"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "A water body outside the reservoir system that receives water from it."@en .

dlv:ImpoundedWaterOverUsefulStorageSpace a iop:AsymmetricSystem ;
    rdfs:label "ImpoundedWater relative to UsefulStorageSpace"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The pair formed by ImpoundedWater (numerator) and UsefulStorageSpace (denominator) of a ratio."@en ;
    iop:hasDenominator dlv:UsefulStorageSpace ;
    iop:hasNumerator dlv:ImpoundedWater .

dlv:InflowVolumeMultiYearMean a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "inflow volume, mean of the same day over three previous years"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "المعدل لنفس اليوم للثلاث السنوات الفارطة"@ar ;
    skos:definition "Page 3 T3 comparator (printed until 2015-10-01)."@en ;
    skos:prefLabel "inflow volume, mean of the same day over three previous years"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasContextObject dlv:CatchmentToReservoirMovement ;
    iop:hasObjectOfInterest dlv:Water ;
    iop:hasProperty dlv:Volume ;
    iop:hasStatisticalModifier dlv:MeanOverPreviousYears .

dlv:InitialStorageSpace a iop:Entity ;
    rdfs:label "initial storage space"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The total storage space of the reservoir at commissioning."@en .

dlv:InitialTotalCapacity a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "initial total capacity"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Cap. totale initiale"@fr ;
    skos:definition "Total capacity at commissioning."@en ;
    skos:prefLabel "initial total capacity"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasConstraint dlv:AtCommissioning ;
    iop:hasObjectOfInterest dlv:ReservoirBasin ;
    iop:hasProperty dlv:Volume .

dlv:LayerUpToMaximumLevel a iop:Constraint ;
    rdfs:label "layer up to maximum level"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Restricts the basin to the empty layer between the current water level and the maximum level."@en ;
    iop:constrains dlv:ReservoirBasin .

dlv:LayerUpToNormalPoolLevel a iop:Constraint ;
    rdfs:label "layer up to normal pool level"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Restricts the basin to the empty layer between the current water level and the normal pool level."@en ;
    iop:constrains dlv:ReservoirBasin .

dlv:MeanAnnualInflowVolume a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "mean annual inflow volume"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Apport annuel moyen"@fr ;
    skos:definition "Long-term mean annual inflow (design/reference)."@en ;
    skos:prefLabel "mean annual inflow volume"@en ;
    dlo:canonicalUnit dlu:MegaM3-PER-YR ;
    iop:hasContextObject dlv:CatchmentToReservoirMovement ;
    iop:hasObjectOfInterest dlv:Water ;
    iop:hasProperty dlv:VolumeRate ;
    iop:hasStatisticalModifier dlv:LongTermMean .

dlv:Minimum a iop:StatisticalModifier ;
    rdfs:label "minimum"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Minimum over the stated period."@en .

dlv:MinimumAnnualInflowVolume a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "minimum annual inflow since impoundment (contested)"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Minimum depuis mise en eau"@fr ;
    skos:definition "Registry reading (Batch-2). Alternative reading 'minimum volume since impoundment' not excluded."@en ;
    skos:prefLabel "minimum annual inflow since impoundment (contested)"@en ;
    dlo:canonicalUnit dlu:MegaM3-PER-YR ;
    iop:hasContextObject dlv:CatchmentToReservoirMovement ;
    iop:hasObjectOfInterest dlv:Water ;
    iop:hasProperty dlv:VolumeRate ;
    iop:hasStatisticalModifier dlv:Minimum .

dlv:NormalPoolCondition a iop:Constraint ;
    rdfs:label "normal pool condition"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The water surface at the design normal pool level."@en ;
    iop:constrains dlv:WaterSurface .

dlv:NormalPoolElevation a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "normal pool elevation"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Côte retenue normale"@fr ;
    skos:definition "Design elevation of the normal pool."@en ;
    skos:prefLabel "normal pool elevation"@en ;
    dlo:canonicalUnit unit:M ;
    iop:hasConstraint dlv:NormalPoolCondition ;
    iop:hasObjectOfInterest dlv:WaterSurface ;
    iop:hasProperty dlv:Elevation .

dlv:OperationType a iop:Property ;
    rdfs:label "operation type"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "A category of reservoir operation."@en .

dlv:Precipitation a iop:Entity ;
    rdfs:label "precipitation"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Water falling as rain."@en .

dlv:PrecipitationDepth a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "precipitation depth at the dam"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Pluviométrie"@fr ;
    skos:definition "Rain depth measured at the dam site over the reporting interval."@en ;
    skos:prefLabel "precipitation depth at the dam"@en ;
    dlo:canonicalUnit unit:MilliM ;
    iop:hasContextObject dlv:DamSite ;
    iop:hasObjectOfInterest dlv:Precipitation ;
    iop:hasProperty dlv:Depth .

dlv:RegulatedVolume a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "calculated regulated volume (contested)"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Capacité régulière"@fr,
        "Volume régul. calculé"@fr ;
    skos:definition "Planning/regulation quantity; not current storage."@en ;
    skos:prefLabel "calculated regulated volume (contested)"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasContextObject dlv:ReservoirToDownstreamSystemMovement ;
    iop:hasObjectOfInterest dlv:Water ;
    iop:hasProperty dlv:Volume ;
    iop:hasStatisticalModifier dlv:ModelEstimate .

dlv:ReportedOperation a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "reported operation type"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Lâchers – action"@fr ;
    skos:definition "Categorical operation code(s) printed beside the release (spill, turbining, transfer …)."@en ;
    skos:prefLabel "reported operation type"@en ;
    iop:hasObjectOfInterest dlv:ReservoirOperation ;
    iop:hasProperty dlv:OperationType .

dlv:ReservoirOperation a iop:Entity ;
    rdfs:label "reservoir operation"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "An action taken by the operator on the reservoir."@en .

dlv:ReservoirToAtmosphereMovement a iop:AsymmetricSystem ;
    rdfs:label "water movement from Reservoir to Atmosphere"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The directed system in which water moves from a Reservoir (source) to a Atmosphere (target)."@en ;
    iop:hasSource dlv:Reservoir ;
    iop:hasTarget dlv:Atmosphere .

dlv:ReservoirToExternalDestinationMovement a iop:AsymmetricSystem ;
    rdfs:label "water movement from Reservoir to ExternalDestination"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The directed system in which water moves from a Reservoir (source) to a ExternalDestination (target)."@en ;
    iop:hasSource dlv:Reservoir ;
    iop:hasTarget dlv:ExternalDestination .

dlv:ReservoirToReservoirMovement a iop:AsymmetricSystem ;
    rdfs:label "water movement from Reservoir to Reservoir"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The directed system in which water moves from a Reservoir (source) to a Reservoir (target)."@en ;
    iop:hasSource dlv:Reservoir ;
    iop:hasTarget dlv:Reservoir .

dlv:SedimentOverInitialStorageSpace a iop:AsymmetricSystem ;
    rdfs:label "Sediment relative to InitialStorageSpace"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The pair formed by Sediment (numerator) and InitialStorageSpace (denominator) of a ratio."@en ;
    iop:hasDenominator dlv:InitialStorageSpace ;
    iop:hasNumerator dlv:Sediment .

dlv:SedimentVolume a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "measured sediment volume"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Envasement (mesuré)"@fr ;
    skos:definition "Sediment volume measured at the last bathymetric survey."@en ;
    skos:prefLabel "measured sediment volume"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasContextObject dlv:ReservoirBasin ;
    iop:hasObjectOfInterest dlv:Sediment ;
    iop:hasProperty dlv:Volume .

dlv:SedimentationFraction a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "sedimentation as percent of initial capacity"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Envasement %"@fr ;
    skos:definition "Measured sediment volume as a percentage of the initial total capacity."@en ;
    skos:prefLabel "sedimentation as percent of initial capacity"@en ;
    dlo:canonicalUnit unit:PERCENT ;
    iop:hasObjectOfInterest dlv:SedimentOverInitialStorageSpace ;
    iop:hasProperty dlv:Ratio .

dlv:SedimentationRate a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "mean annual sedimentation"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Envasement annuel"@fr ;
    skos:definition "Annualised sediment accumulation."@en ;
    skos:prefLabel "mean annual sedimentation"@en ;
    dlo:canonicalUnit dlu:MegaM3-PER-YR ;
    iop:hasContextObject dlv:ReservoirBasin ;
    iop:hasObjectOfInterest dlv:Sediment ;
    iop:hasProperty dlv:VolumeRate ;
    iop:hasStatisticalModifier dlv:LongTermMean .

dlv:Soil a iop:Entity ;
    rdfs:label "soil"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Soil of the catchment eroded and carried to the reservoir."@en .

dlv:SpillwayDesign a iop:Constraint ;
    rdfs:label "spillway design"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "At the design capacity of the spillway."@en ;
    iop:constrains dlv:Water .

dlv:SpillwayDesignDischarge a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "maximum spillway discharge"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Débit max évacuateur"@fr ;
    skos:definition "Design maximum discharge of the spillway."@en ;
    skos:prefLabel "maximum spillway discharge"@en ;
    dlo:canonicalUnit unit:M3-PER-SEC ;
    iop:hasConstraint dlv:SpillwayDesign ;
    iop:hasContextObject dlv:ReservoirToDownstreamSystemMovement ;
    iop:hasObjectOfInterest dlv:Water ;
    iop:hasProperty dlv:DischargeRate .

dlv:StoredWaterVolumeAnomaly a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "stored volume minus multi-year mean"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "الفارق"@ar ;
    skos:definition "Printed difference between current stored volume and its comparator. Printed sign kept."@en ;
    skos:prefLabel "stored volume minus multi-year mean"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasObjectOfInterest dlv:ImpoundedWater ;
    iop:hasProperty dlv:Volume ;
    iop:hasStatisticalModifier dlv:DifferenceFromReference .

dlv:StoredWaterVolumeMultiYearMean a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "stored volume, mean of the same day over the three previous years"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "المعدل لنفس اليوم للثلاث السنوات الفارطة"@ar ;
    skos:definition "Three-year same-day mean printed as a comparator (Page 3 T1)."@en ;
    skos:prefLabel "stored volume, mean of the same day over the three previous years"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasObjectOfInterest dlv:ImpoundedWater ;
    iop:hasProperty dlv:Volume ;
    iop:hasStatisticalModifier dlv:MeanOverPreviousYears .

dlv:UsefulStorageSpace a iop:Entity ;
    rdfs:label "useful storage space"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The part of the reservoir basin that can be used for storage and release."@en .

hyf:HY_Catchment a owl:Class ;
    rdfs:isDefinedBy <https://www.opengis.net/def/schema/hy_features/hyf> .

hyf:HY_Impoundment a owl:Class ;
    rdfs:isDefinedBy <https://www.opengis.net/def/schema/hy_features/hyf> ;
    rdfs:subClassOf hyf:HY_WaterBody .

hyf:HY_Reservoir a owl:Class ;
    rdfs:isDefinedBy <https://www.opengis.net/def/schema/hy_features/hyf> .

hyf:HY_WaterBody a owl:Class ;
    rdfs:isDefinedBy <https://www.opengis.net/def/schema/hy_features/hyf> .

hyf:storedWaterBody a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://www.opengis.net/def/schema/hy_features/hyf> .

obo:ENVO_00000025 a owl:Class ;
    rdfs:isDefinedBy obo:envo.owl .

time:TemporalEntity a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/2006/time> .

dlc:ConfidenceUnresolved a skos:Concept ;
    skos:definition "Meaning not established. No variable is asserted; values are kept only as printed text."@en ;
    skos:inScheme dlc:ConfidenceScheme ;
    skos:notation "UNRESOLVED" ;
    skos:prefLabel "unresolved"@en ;
    skos:topConceptOf dlc:ConfidenceScheme .

dlc:LayerEventContext a skos:Concept ;
    skos:definition "Values whose mathematical behaviour is 'count_or_category'."@en ;
    skos:inScheme dlc:SemanticLayerScheme ;
    skos:notation "event_context" ;
    skos:prefLabel "event context"@en ;
    skos:topConceptOf dlc:SemanticLayerScheme ;
    dlo:safeCrossReservoirAggregation "count/group with explicit denominator"@en ;
    dlo:safeTemporalAggregation "count/group incidents; do not treat as volume"@en .

dlc:LayerSchemaDependent a skos:Concept ;
    skos:definition "Values whose mathematical behaviour is 'none'."@en ;
    skos:inScheme dlc:SemanticLayerScheme ;
    skos:notation "schema_dependent" ;
    skos:prefLabel "schema dependent"@en ;
    skos:topConceptOf dlc:SemanticLayerScheme ;
    dlo:safeCrossReservoirAggregation "prohibited"@en ;
    dlo:safeTemporalAggregation "prohibited until date-effective split"@en .

dlc:MultiYearSameDayReference a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/average/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/Continuous> ;
    skos:definition "The mean of a state at the same calendar date in the three previous years (Page 3). The phenomenon time is the representative date D."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "MULTI_YEAR_SAME_DAY_REFERENCE" ;
    skos:prefLabel "mean of the same date over the three previous years"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:cfCellMethods "time: point within years time: mean over years" ;
    dlo:phenomenonTimePattern "instant(D)" ;
    dlo:supportedBy <https://w3id.org/damlevels/id/test/H27d> .

dlc:NoValueInExtract a skos:Concept ;
    skos:definition "The extracted table holds no value for a cell inside the column's regime. The extract does not say whether the cell was blank, a dash or unreadable."@en ;
    skos:inScheme dlc:ValueStatusScheme ;
    skos:notation "NO_VALUE_IN_EXTRACT" ;
    skos:prefLabel "no value in the extract"@en ;
    skos:scopeNote "Covers the project states raw_blank, explicit_missing_token and malformed_or_unresolved_token (PATCH_04) for Page 1 and Page 2, whose observation tables do not separate them."@en ;
    skos:topConceptOf dlc:ValueStatusScheme .

dlc:RoleDam a skos:Concept ;
    rdfs:seeAlso dlo:Dam ;
    skos:definition "Values are about a feature of class dlo:Dam."@en ;
    skos:inScheme dlc:FeatureRoleScheme ;
    skos:notation "DAM" ;
    skos:prefLabel "dam"@en ;
    skos:topConceptOf dlc:FeatureRoleScheme .

<https://w3id.org/damlevels/id/page/00af1152bbeb833034a5e58095dfecc3b8a32282392a125feaf7c159c92504a4> a dlo:BulletinPage ;
    dlo:pageNumber "2"^^xsd:positiveInteger ;
    dlo:sha256 "00af1152bbeb833034a5e58095dfecc3b8a32282392a125feaf7c159c92504a4" ;
    dlo:sourceFileName "12-7-2014_2.pdf" .

