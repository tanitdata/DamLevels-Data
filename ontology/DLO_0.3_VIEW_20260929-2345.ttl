<https://w3id.org/damlevels/id/test/H27a> a dlo:SemanticTest ;
    dcterms:description "p3_t1_stock_difference_mm3 = p3_t1_stock_current_season_today_mm3 - p3_t1_stock_3yr_same_day_avg_mm3 (sign as printed)"@en ;
    dcterms:identifier "H27a" ;
    dcterms:source "analysis/test_aggregation_semantics.py" ;
    rdfs:comment "magnitude-only match: 3960/3960"@en ;
    skos:note "The printed difference is a derived observation (current minus comparator) with the comparator's temporal support."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P3_FACTS_LONG> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 100.000 ;
    dlo:comparedCases "3960"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "3960"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H27b> a dlo:SemanticTest ;
    dcterms:description "p3_t3_inflow_difference_vs_period_mm3 = p3_t3_inflow_current_season_cum_mm3 - p3_t3_inflow_period_average_mm3 (sign as printed)"@en ;
    dcterms:identifier "H27b" ;
    dcterms:source "analysis/test_aggregation_semantics.py" ;
    rdfs:comment "magnitude-only match: 3962/3962"@en ;
    skos:note "The printed difference is a derived observation (current minus comparator) with the comparator's temporal support."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P3_FACTS_LONG> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 100.000 ;
    dlo:comparedCases "3962"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "3962"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H28a> a dlo:SemanticTest ;
    dcterms:description "p3_t3_inflow_current_season_cum_mm3 equals the sum of Page 1 p1_apport_cumul_since_sep over all dams printed that day (rounding bound)"@en ;
    dcterms:identifier "H28a" ;
    dcterms:source "analysis/test_aggregation_semantics.py" ;
    rdfs:comment "before 2024-01-09: 3314/3323; from 2024-01-09: 638/638"@en ;
    skos:note "The national comparator has the same temporal support as its Page 1 per-dam counterpart."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations>,
        <https://w3id.org/damlevels/id/source-table/P3_FACTS_LONG> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 99.773 ;
    dlo:comparedCases "3961"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "3952"^^xsd:nonNegativeInteger .

<https://w3id.org/damlevels/id/test/H28b> a dlo:SemanticTest ;
    dcterms:description "p3_t3_inflow_period_average_mm3 equals the sum of Page 1 p1_apport_average_period over all dams printed that day (rounding bound)"@en ;
    dcterms:identifier "H28b" ;
    dcterms:source "analysis/test_aggregation_semantics.py" ;
    rdfs:comment "before 2024-01-09: 3318/3324; from 2024-01-09: 638/638"@en ;
    skos:note "The national comparator has the same temporal support as its Page 1 per-dam counterpart."@en ;
    dqv:computedOn <https://w3id.org/damlevels/id/source-table/P1_observations>,
        <https://w3id.org/damlevels/id/source-table/P3_FACTS_LONG> ;
    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 99.849 ;
