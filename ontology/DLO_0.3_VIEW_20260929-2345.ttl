    skos:prefLabel "one per printed value"@en ;
    skos:topConceptOf dlc:EmissionModeScheme .

dlo: a owl:Ontology ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:description "Ontology for the daily reservoir bulletins of the Tunisian Direction Générale des Barrages et des Grands Travaux Hydrauliques (DGBGTH). It represents each printed quantity as a W3C SOSA observation whose observed property is an RDA I-ADOPT variable, whose phenomenon time is an OWL-Time entity fixed by an empirically tested temporal support rule, and whose result is a QUDT quantity value. Dams, impounded water bodies, managed reservoirs and catchments align with OGC HY_Features and OBO ENVO. Lineage uses W3C PROV-O."@en ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    dcterms:references qudt:,
        skos:,
        time:,
        dqv:,
        prov:,
        sosa:,
        iop:,
        hyf: ;
    dcterms:source <https://w3id.org/damlevels/ontology/docs/research-design> ;
    dcterms:title "DamLevels Ontology (DLO)"@en,
        "Ontologie DamLevels"@fr ;
    vann:preferredNamespacePrefix "dlo" ;
    vann:preferredNamespaceUri "https://w3id.org/damlevels/ontology/" ;
    rdfs:comment "Namespace https://w3id.org/damlevels/ is a placeholder until registered with w3id.org. Licence and creators are deliberately not asserted until the project owner approves them (see docs/PUBLICATION_CHECKLIST.md). sosa:ObservationCollection, sosa:hasMember and sosa:Property come from the SOSA/SSN revision (W3C draft); variables are also typed with the 2017 sosa:ObservableProperty."@en,
        "PROTÉGÉ VIEW FILE (20260929-2345) — merged schema modules + features + 200 sample observations, no owl:imports. For looking only: the source modules are the dlo-*.ttl files."@en ;
    owl:priorVersion <https://w3id.org/damlevels/ontology/0.2.0/> ;
    owl:versionIRI <https://w3id.org/damlevels/ontology/0.3.0/> ;
    owl:versionInfo "0.3.0 — research build of 2026-09-29, pending owner review" .

skos:Concept a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

<https://w3id.org/damlevels/id/page/0bb4012348163c1848cc9242a308e79b22b9330e78077a895259477d4b6032c5> a dlo:BulletinPage ;
    dlo:pageNumber "1"^^xsd:positiveInteger ;
    dlo:sha256 "0bb4012348163c1848cc9242a308e79b22b9330e78077a895259477d4b6032c5" ;
    dlo:sourceFileName "01-02-2020_1.pdf" .

dlo:ColumnMapping a owl:Class ;
    rdfs:label "column mapping"@en ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf sosa:Procedure ;
    skos:definition "The procedure that turns one printed column (or one Page 3 field at one grain) of one source table, inside one schema regime, into observations of one variable with one temporal support rule, one unit and one feature role. Every observation names the column mapping it was produced with (sosa:usedProcedure)."@en .

dlv:StoredWaterVolume a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "stored water volume"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Stocks"@fr,
        "Volume correspondant"@fr ;
    skos:definition "Volume of water held in a reservoir (or summed over a set of reservoirs) at a moment."@en ;
    skos:prefLabel "stored water volume"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasObjectOfInterest dlv:ImpoundedWater ;
    iop:hasProperty dlv:Volume .

dlc:PresentNumeric a skos:Concept ;
    skos:definition "A non-zero number was printed and read."@en ;
    skos:inScheme dlc:ValueStatusScheme ;
    skos:notation "PRESENT_NUMERIC" ;
    skos:prefLabel "printed number"@en ;
    skos:topConceptOf dlc:ValueStatusScheme .

qudt:QuantityValue a owl:Class ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> .

dlo:BulletinObservation a owl:Class ;
    rdfs:label "bulletin observation"@en ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sosa:usedProcedure ;
            owl:someValuesFrom dlo:ColumnMapping ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass iop:Variable ;
            owl:onProperty sosa:observedProperty ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass sosa:FeatureOfInterest ;
            owl:onProperty sosa:hasFeatureOfInterest ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass skos:Concept ;
            owl:onProperty dlo:valueStatus ],
        sosa:Observation ;
    skos:definition "One printed cell of a bulletin table (a number, a zero, a blank or a text) interpreted as an observation: one feature of interest, one I-ADOPT variable, one phenomenon time given by the temporal support rule of its column mapping, and at most one result."@en ;
    skos:scopeNote "The same variable, feature and time printed on two pages gives two observations (repeated reporting). They are compared, never merged. When the temporal support is unresolved, no phenomenon time is asserted. Lineage: the observation prov:used the bulletin page it was read from; it is not declared a prov:Entity, so that it stays compatible with the SSN alignment of sosa:Observation to prov:Activity."@en .

dlu:MegaM3 a qudt:Unit ;
    rdfs:label "million cubic metres"@en,
        "million de mètres cubes"@fr ;
    qudt:conversionMultiplier 1000000.0 ;
    qudt:hasDimensionVector qkdv:A0E0L3I0M0H0T0D0 ;
    qudt:hasQuantityKind qk:Volume ;
    qudt:symbol "hm³" ;
    qudt:ucumCode "hm3"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "Mm³" ;
    skos:definition "Local unit: QUDT has no unit for 10^6 m³. Printed as 'Mm3' or 'Mm³' in the bulletins; the unambiguous symbol is hm³ (in SI notation Mm³ would mean cubic megametre). Conversion multiplier to the SI unit given with a Julian year (365.25 d) where a year is involved."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( dlo:Dam dlo:ReservoirWaterBody dlo:ManagedReservoir dlo:Catchment dlo:ReservoirAggregate dlo:TransferRoute dlo:AccountingLine dlo:ExternalDestination dlo:PrintedRowSlot ) .

[] a owl:AllDisjointClasses ;
    owl:members ( dlo:NationalReservoirSystem dlo:RegionalReservoirGroup ) .

