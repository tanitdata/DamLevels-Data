        "national reservoir system"@en,
        "total général"@fr ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf dlo:ReservoirAggregate ;
    skos:definition "All reservoirs of the bulletin roster (Page 1 'TOTAL' row, Page 3 national rows)."@en .

dlv:LongTermMean a iop:StatisticalModifier ;
    rdfs:label "long term mean"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Mean over a long reference period of years that the bulletin does not state."@en .

dlv:ReservoirToDownstreamSystemMovement a iop:AsymmetricSystem ;
    rdfs:label "water movement from Reservoir to DownstreamSystem"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The directed system in which water moves from a Reservoir (source) to a DownstreamSystem (target)."@en ;
    iop:hasSource dlv:Reservoir ;
    iop:hasTarget dlv:DownstreamSystem .

dlv:StorageFillRatio a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "storage fill percentage"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "نسبة الامتلاء"@ar,
        "Taux de remplissage"@fr ;
    skos:definition "Stored volume divided by the useful capacity in force, in percent, as printed."@en ;
    skos:prefLabel "storage fill percentage"@en ;
    dlo:canonicalUnit unit:PERCENT ;
    iop:hasObjectOfInterest dlv:ImpoundedWaterOverUsefulStorageSpace ;
    iop:hasProperty dlv:Ratio .

prov:Entity a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

dlc:LayerStaticAttribute a skos:Concept ;
    skos:definition "Values whose mathematical behaviour is 'as_of'."@en ;
    skos:inScheme dlc:SemanticLayerScheme ;
    skos:notation "static_attribute" ;
    skos:prefLabel "static attribute"@en ;
    skos:topConceptOf dlc:SemanticLayerScheme ;
    dlo:safeCrossReservoirAggregation "only with a defined cross-dam meaning"@en ;
    dlo:safeTemporalAggregation "as-of per dam; flag conflicts"@en .

dlc:PreviousYearSeasonToDate a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/cumulative/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/InstantTotal> ;
    skos:definition "The season-to-date total as it stood on the reference bulletin one year earlier: from 1 September of hy(R(D)-1) to R(D)-1."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "PREVIOUS_YEAR_SEASON_TO_DATE" ;
    skos:prefLabel "running season total one year earlier"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:cfCellMethods "time: sum" ;
    dlo:phenomenonTimePattern "interval(01-09-hy(R(D)-1) .. R(D))" ;
    dlo:supportedBy <https://w3id.org/damlevels/id/test/H04>,
        <https://w3id.org/damlevels/id/test/H04c>,
        <https://w3id.org/damlevels/id/test/H05>,
        <https://w3id.org/damlevels/id/test/H05c> .

dlc:RoleRowSlot a skos:Concept ;
    rdfs:seeAlso dlo:PrintedRowSlot ;
    skos:definition "Values are about a feature of class dlo:PrintedRowSlot."@en ;
    skos:inScheme dlc:FeatureRoleScheme ;
    skos:notation "ROW_SLOT" ;
    skos:prefLabel "row slot"@en ;
    skos:topConceptOf dlc:FeatureRoleScheme .

