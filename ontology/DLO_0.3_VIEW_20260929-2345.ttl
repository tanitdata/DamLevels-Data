    time:hasXSDDuration "P1D"^^xsd:duration .

dlo:Dam a owl:Class ;
    rdfs:label "سد"@ar,
        "dam"@en,
        "barrage"@fr ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf obo:ENVO_00000074,
        sosa:FeatureOfInterest ;
    skos:definition "The engineered barrier structure that impounds a water body. Only structural quantities (for example spillway design discharge) are about the dam itself."@en .

dlo:ManagedReservoir a owl:Class ;
    rdfs:label "managed reservoir"@en,
        "réservoir (ouvrage géré)"@fr ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf sosa:FeatureOfInterest,
        hyf:HY_Reservoir ;
    skos:definition "A reservoir as a managed storage facility listed in the bulletin roster: its basin, its capacities, its sedimentation and its operation. It stores exactly one reservoir water body and is created by one dam."@en ;
    skos:scopeNote "Capacities, sedimentation, normal pool level and reported operations are properties of the managed reservoir, not of the water body at a given moment."@en .

dlo:ReservoirWaterBody a owl:Class ;
    rdfs:label "reservoir water body"@en,
        "retenue"@fr ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf obo:ENVO_00000025,
        sosa:FeatureOfInterest,
        hyf:HY_Impoundment ;
    skos:definition "The body of water held behind a dam. Stored volume, water surface elevation, inflow and release are quantities of this water body."@en .

dlc:ConfidenceHigh a skos:Concept ;
    skos:definition "Supported by a corpus test (normally at least 90 % of comparable cases, with the alternative readings clearly worse) or by an accepted decision, and not contradicted."@en ;
    skos:inScheme dlc:ConfidenceScheme ;
    skos:notation "HIGH" ;
    skos:prefLabel "high"@en ;
    skos:topConceptOf dlc:ConfidenceScheme .

