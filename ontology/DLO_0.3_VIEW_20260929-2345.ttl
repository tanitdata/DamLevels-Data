    dqv:isMeasurementOf <https://w3id.org/damlevels/id/metric/semantic-support> ;
    dqv:value 100.000 ;
    dlo:comparedCases "3981"^^xsd:nonNegativeInteger ;
    dlo:isNegativeControl false ;
    dlo:supportingCases "3981"^^xsd:nonNegativeInteger .

