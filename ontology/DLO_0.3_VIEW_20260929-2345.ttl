dlo:ExternalDestination a owl:Class ;
    rdfs:label "external destination"@en ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf sosa:FeatureOfInterest ;
    skos:definition "A water body outside the reservoir roster that receives deliveries from it (Lake Ichkeul, Page 3 table T6)."@en .

dlo:ExtractionRun a owl:Class ;
    rdfs:label "extraction run"@en ;
    rdfs:isDefinedBy dlo: ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "One execution of an extraction engine over the bulletin corpus."@en .

dlv:AccountedInflowVolume a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "inflow volume accounted through transfer"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "إيرادات سد سجنان باعتماد التحويل"@ar ;
    skos:definition "Bookkeeping line printed on Page 3 T5. Not a physical transfer; never added to transfer sums."@en ;
    skos:prefLabel "inflow volume accounted through transfer"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasConstraint dlv:AccountingDefinition ;
    iop:hasContextObject dlv:CatchmentToReservoirMovement ;
    iop:hasObjectOfInterest dlv:Water ;
    iop:hasProperty dlv:Volume .

dlv:Catchment a iop:Entity ;
    rdfs:label "catchment"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The land area draining to the reservoir."@en .

dlv:DeliveredWaterVolume a sosa:ObservableProperty,
        sosa:Property,
        iop:Variable ;
    rdfs:label "water volume delivered to an external destination"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:altLabel "بحيرة إشكل"@ar,
        "Lâcher vers Ichkeul"@fr ;
    skos:definition "Environmental release to Lake Ichkeul (Page 3 T6)."@en ;
    skos:prefLabel "water volume delivered to an external destination"@en ;
    dlo:canonicalUnit dlu:MegaM3 ;
    iop:hasContextObject dlv:ReservoirToExternalDestinationMovement ;
    iop:hasObjectOfInterest dlv:Water ;
    iop:hasProperty dlv:Volume .

dlv:Sediment a iop:Entity ;
    rdfs:label "sediment"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "Solid material deposited in the reservoir basin."@en .

dlv:VolumeRate a iop:Property ;
    rdfs:label "volume rate"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:closeMatch qk:VolumeFlowRate ;
    skos:definition "A volume per year."@en .

dlv:WaterSurface a iop:Entity ;
    rdfs:label "water surface"@en ;
    rdfs:isDefinedBy <https://w3id.org/damlevels/ontology/module/variables> ;
    skos:definition "The free surface of the water held in a reservoir."@en .

qudt:Unit a owl:Class ;
    rdfs:isDefinedBy <http://qudt.org/schema/qudt> .

dlc:EmissionModeScheme a skos:ConceptScheme ;
    skos:definition "How many observations a printed column produces."@en ;
    skos:hasTopConcept dlc:EmitPerPrintedValue,
        dlc:EmitRunLength ;
    skos:prefLabel "emission modes"@en .

dlc:LongTermSeasonToDateReference a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/average/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/InstantTotal> ;
    skos:definition "A climatological mean of the season-to-date total for the same span 1 September to D-1. The phenomenon time is the representative span; averaging years unknown."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "LONG_TERM_SEASON_TO_DATE_REFERENCE" ;
    skos:prefLabel "long-term mean of the season-to-date total"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:cfCellMethods "time: sum within years time: mean over years" ;
    dlo:phenomenonTimePattern "interval(01-09-hy(D-1) .. D)" ;
    dlo:supportedBy <https://w3id.org/damlevels/id/test/H16>,
        <https://w3id.org/damlevels/id/test/H16b> .

dlc:PreviousSeasonToDateUnresolved a skos:Concept ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/cumulative/>,
        <http://www.opengis.net/def/waterml/2.0/interpolationType/InstantTotal> ;
    skos:definition "A running total for the previous season whose exact span is not established (Page 1 and Page 3 print different values). No phenomenon time is asserted."@en ;
    skos:inScheme dlc:TemporalSupportScheme ;
    skos:notation "PREVIOUS_SEASON_TO_DATE_UNRESOLVED" ;
    skos:prefLabel "previous-season running total (time unresolved)"@en ;
    skos:topConceptOf dlc:TemporalSupportScheme ;
    dlo:cfCellMethods "time: sum" ;
    dlo:phenomenonTimePattern "none" .

dlc:RoleAccounting a skos:Concept ;
    rdfs:seeAlso dlo:AccountingLine ;
    skos:definition "Values are about a feature of class dlo:AccountingLine."@en ;
    skos:inScheme dlc:FeatureRoleScheme ;
    skos:notation "ACCOUNTING" ;
    skos:prefLabel "accounting"@en ;
    skos:topConceptOf dlc:FeatureRoleScheme .

dlc:RoleExternal a skos:Concept ;
    rdfs:seeAlso dlo:ExternalDestination ;
    skos:definition "Values are about a feature of class dlo:ExternalDestination."@en ;
    skos:inScheme dlc:FeatureRoleScheme ;
    skos:notation "EXTERNAL" ;
    skos:prefLabel "external"@en ;
    skos:topConceptOf dlc:FeatureRoleScheme .

dlc:RoleRoute a skos:Concept ;
    rdfs:seeAlso dlo:TransferRoute ;
    skos:definition "Values are about a feature of class dlo:TransferRoute."@en ;
    skos:inScheme dlc:FeatureRoleScheme ;
    skos:notation "ROUTE" ;
    skos:prefLabel "route"@en ;
    skos:topConceptOf dlc:FeatureRoleScheme .

