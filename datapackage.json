          },
          {
            "name": "capacity_valid_from",
            "type": "date",
            "description": "Start of latest observed capacity regime."
          },
          {
            "name": "latitude",
            "type": "number",
            "description": "Accepted control latitude, EPSG:4326."
          },
          {
            "name": "longitude",
            "type": "number",
            "description": "Accepted control longitude, EPSG:4326."
          },
          {
            "name": "status",
            "type": "string",
            "description": "Task21 row status."
          },
          {
            "name": "geometry_status",
            "type": "string",
            "description": "Task21 geometry status."
          },
          {
            "name": "control_status",
            "type": "string",
            "description": "Task21 control-point status."
          },
          {
            "name": "identity_source",
            "type": "string",
            "description": "Identity evidence path."
          },
          {
            "name": "coordinate_source",
            "type": "string",
            "description": "Coordinate evidence path and transform."
          },
          {
            "name": "capacity_source",
            "type": "string",
