{
  "profile": "data-package",
  "name": "damlevels-data",
  "title": "DamLevels-Data: daily storage of Tunisia's 36 large dams, 2014-2025",
  "description": "Provenance-traced daily storage observations, qualified inter-dam transfer facts, dam metadata, QA results and GIS layers reconstructed from the DGBGTH bulletins published by ONAGRI. Current quality indicators: qa/kpi/results.",
  "version": "1.0.0",
  "licenses": [
    {
      "name": "CC-BY-4.0",
      "path": "https://creativecommons.org/licenses/by/4.0/",
      "title": "Creative Commons Attribution 4.0 International (tables and documentation; see LICENSE-DATA)"
    },
    {
      "name": "TN-LNDPO",
      "path": "LICENSE-DATA",
      "title": "Source values: Licence Nationale de Données Publiques Ouvertes (Tunisie); attribution to DGBGTH/ONAGRI required"
    }
  ],
  "resources": [
    {
