            "description": "Authority or candidate status of the Arabic-name mapping."
          },
          {
            "name": "name_ar_source",
            "type": "string",
            "description": "Evidence locator for the Arabic name."
          },
          {
            "name": "aliases",
            "type": "string",
            "description": "Pipe-separated governed historical aliases."
          },
          {
            "name": "basin",
            "type": "string",
            "description": "Hydrographic basin only where explicitly supported."
          },
          {
            "name": "basin_status",
