{
  "table": "p3_performance_counters",
  "grain": "one row per (run, source PDF) of stage counters and timings",
  "primary_key": [
    "run_id",
    "source_sha256"
  ],
  "layer": "07_performance",
  "columns": [
    {
      "name": "run_id",
      "type": "string",
      "nullable": false,
      "description": "run identity this row was produced by"
    },
    {
      "name": "extractor_version",
      "type": "string",
      "nullable": false,
      "description": "page3_extractor version"
    },
    {
