      "nullable": false,
      "description": "hash of the exact parameters this run used"
    },
    {
      "name": "created_at",
      "type": "datetime",
      "nullable": false,
      "description": "row creation timestamp, UTC ISO-8601"
    },
    {
      "name": "page_index",
      "type": "int",
      "nullable": false,
      "description": ""
    },
    {
      "name": "route_id",
      "type": "string",
      "nullable": false,
      "description": "e.g. RT-01..RT-07"
    },
    {
      "name": "preflight_class",
      "type": "string",
      "nullable": false,
      "description": ""
    },
    {
      "name": "geometry_engine",
      "type": "string",
      "nullable": false,
      "description": ""
    },
    {
      "name": "numeric_engine",
      "type": "string",
      "nullable": false,
      "description": ""
    },
    {
      "name": "anchor_engine",
      "type": "string",
      "nullable": false,
      "description": ""
    },
    {
      "name": "label_engine",
      "type": "string",
      "nullable": true,
      "description": ""
    },
    {
      "name": "fallback_engines_json",
      "type": "json",
      "nullable": true,
      "description": ""
    },
    {
      "name": "trigger_evidence_json",
      "type": "json",
      "nullable": true,
      "description": ""
    },
    {
      "name": "decision_confidence",
      "type": "float",
      "nullable": false,
      "description": ""
    },
    {
      "name": "terminal_status",
      "type": "string",
      "nullable": false,
      "description": "enum: routed|review|quarantine"
    }
  ],
  "enums": {
